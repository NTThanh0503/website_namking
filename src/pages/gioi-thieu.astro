---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Stats from '../components/Stats.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import ArtTile from '../components/ArtTile.astro';
import { company, values, milestones, team } from '../data/site';
const valueIcons = ['eye', 'leaf', 'heart'];
const initials = (n: string) => n.split(' ').slice(-2).map((w) => w[0]).join('');
---
<BaseLayout title="Giới thiệu" description={`Câu chuyện, giá trị và đội ngũ của ${company.name}.`}>
  <PageHero
    title="Chúng tôi đưa điểm đến Việt Nam lại gần du khách hơn"
    lead={`${company.name} ra đời năm ${company.founded} với một niềm tin đơn giản: công nghệ nên giúp du khách hiểu đúng và yêu hơn những nơi họ sắp đến.`}
    crumbs={[{ label: 'Giới thiệu' }]}
    seed={23}
  />

  <section class="section">
    <div class="container story">
      <div data-reveal>
        <h2>Câu chuyện của chúng tôi</h2>
        <div class="prose">
          <p>Năm {company.founded}, năm người bạn làm trong ngành khách sạn và công nghệ nhận ra một nghịch lý: rất nhiều homestay, khách sạn nhỏ ở Việt Nam đẹp và chu đáo, nhưng gần như "vô hình" trên mạng. Khách không tìm thấy họ, hoặc thấy nhưng không đủ tin để đặt.</p>
          <p>Chúng tôi bắt đầu bằng việc chụp ảnh 360° cho từng cơ sở. Rồi các chủ nhà nhờ làm thêm website, quản lý kênh bán phòng, đào tạo nhân viên. Khách lưu trú lại hỏi về tour quanh vùng. Hành Trình Số lớn lên từ chính những nhu cầu đó.</p>
          <p>Hôm nay, chúng tôi là đối tác của hơn 120 cơ sở lưu trú và nhiều điểm đến trên cả nước, với cùng một cách làm: hiểu thật kỹ từng nơi trước khi đưa nó lên bản đồ số.</p>
        </div>
      </div>
      <div class="story-art" data-reveal style="--d:120ms">
        <ArtTile tone="jade" seed={61} icon="compass" ratio="4 / 5" />
      </div>
    </div>
  </section>

  <section class="section section--dark">
    <div class="container">
      <div class="section-head" data-reveal>
        <h2>Tầm nhìn và sứ mệnh</h2>
      </div>
      <div class="mission">
        <div data-reveal>
          <h3>Tầm nhìn</h3>
          <p>Trở thành đơn vị hàng đầu Việt Nam về chuyển đổi số cho ngành du lịch và lưu trú, nơi mỗi điểm đến, dù lớn hay nhỏ, đều có cơ hội được du khách biết đến.</p>
        </div>
        <div data-reveal style="--d:120ms">
          <h3>Sứ mệnh</h3>
          <p>Mang đến giải pháp số dễ dùng, chi phí hợp lý và dịch vụ tận tâm, giúp doanh nghiệp du lịch Việt tăng trưởng bền vững cùng cộng đồng địa phương.</p>
        </div>
      </div>
      <div class="stats-wrap"><Stats /></div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head" data-reveal>
        <h2>Giá trị cốt lõi</h2>
        <p class="lead">Ba điều chúng tôi giữ trong mọi dự án, dù là một homestay năm phòng hay một bảo tàng cấp tỉnh.</p>
      </div>
      <div class="values">
        {values.map((v, i) => (
          <article data-reveal style={`--d:${i * 100}ms`}>
            <span class="v-icon"><Icon name={valueIcons[i]} size={26} /></span>
            <h3>{v.title}</h3>
            <p>{v.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container">
      <div class="section-head" data-reveal><h2>Chặng đường phát triển</h2></div>
      <ol class="timeline">
        {milestones.map((m, i) => (
          <li data-reveal style={`--d:${i * 80}ms`}>
            <span class="year">{m.year}</span>
            <p>{m.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head" data-reveal>
        <h2>Đội ngũ lãnh đạo</h2>
        <p class="lead">Những người chịu trách nhiệm trực tiếp với từng dự án của bạn.</p>
      </div>
      <div class="team">
        {team.map((m, i) => (
          <article data-reveal style={`--d:${i * 90}ms`}>
            {/* Thay khối chữ cái bằng ảnh thật: <img src="/images/team/ten.jpg" alt={m.name} /> */}
            <div class="avatar" aria-hidden="true">{initials(m.name)}</div>
            <h3>{m.name}</h3>
            <p class="role">{m.role}</p>
            <p>{m.bio}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CtaBand title="Cùng viết tiếp hành trình với chúng tôi" />
</BaseLayout>

<style>
  .story { display: grid; gap: 3rem; align-items: center; }
  @media (min-width: 960px) { .story { grid-template-columns: 1.3fr .7fr; gap: 5rem; } }
  .prose { margin-top: 1.6rem; display: grid; gap: 1.1rem; color: var(--ink-soft); max-width: 40rem; font-size: 1.08rem; }
  .mission { display: grid; gap: 2.5rem; }
  @media (min-width: 820px) { .mission { grid-template-columns: 1fr 1fr; gap: 4rem; } }
  .mission h3 { color: var(--lantern); margin-bottom: .8rem; }
  .mission p { font-size: 1.15rem; opacity: .9; max-width: 34rem; }
  .stats-wrap { margin-top: clamp(3rem, 7vw, 5rem); }
  .values { display: grid; gap: 2.5rem; }
  @media (min-width: 820px) { .values { grid-template-columns: repeat(3, 1fr); } }
  .v-icon { display: grid; place-items: center; width: 58px; height: 58px; border-radius: 18px; background: var(--mist); color: var(--lagoon); margin-bottom: 1.4rem; }
  .values p { margin-top: .6rem; color: var(--ink-soft); }
  .timeline { list-style: none; padding: 0; margin: 0; position: relative; display: grid; gap: 0; }
  .timeline::before { content: ''; position: absolute; left: 5.2rem; top: .6rem; bottom: .6rem; width: 2px; background: color-mix(in srgb, var(--lagoon) 25%, transparent); }
  .timeline li { position: relative; display: grid; grid-template-columns: 4.2rem 1fr; gap: 2.2rem; padding-block: 1.1rem; }
  .timeline li::after { content: ''; position: absolute; left: calc(5.2rem - 6px); top: 1.55rem; width: 14px; height: 14px; border-radius: 50%; background: var(--lantern); box-shadow: 0 0 0 5px var(--mist); }
  .year { font-weight: 700; font-size: 1.3rem; letter-spacing: -0.02em; color: var(--lagoon); }
  .timeline p { max-width: 40rem; padding-top: .15rem; }
  .team { display: grid; gap: 2.5rem 2rem; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }
  .avatar { aspect-ratio: 1; border-radius: var(--radius-m); background: var(--lagoon); color: var(--paper); display: grid; place-items: center; font-size: 2.8rem; font-weight: 700; letter-spacing: -0.04em; margin-bottom: 1.2rem; }
  .team article:nth-child(2) .avatar { background: var(--jade); }
  .team article:nth-child(3) .avatar { background: var(--ink); }
  .team article:nth-child(4) .avatar { background: #e9a72a; color: var(--ink); }
  .team h3 { font-size: 1.2rem; }
  .role { color: var(--jade); font-weight: 600; font-size: .95rem; margin: .2rem 0 .5rem; }
  .team p:last-child { color: var(--ink-soft); font-size: .95rem; }
</style>
