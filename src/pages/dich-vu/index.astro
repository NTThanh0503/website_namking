---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import ArtTile from '../../components/ArtTile.astro';
import Process from '../../components/Process.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import { services } from '../../data/site';
---
<BaseLayout title="Dịch vụ" description="Số hóa điểm đến, tư vấn vận hành lưu trú và thiết kế tour du lịch trọn gói.">
  <PageHero
    title="Dịch vụ của chúng tôi"
    lead="Ba lĩnh vực bổ trợ cho nhau. Bạn có thể chọn từng dịch vụ riêng lẻ hoặc kết hợp thành một giải pháp trọn gói."
    crumbs={[{ label: 'Dịch vụ' }]}
    seed={31}
  />

  <section class="section">
    <div class="container list">
      {services.map((s, i) => (
        <article class:list={['svc', `tone-${s.tone}`, { flip: i % 2 === 1 }]} id={s.slug}>
          <div data-reveal><ArtTile tone={s.tone} seed={i * 13 + 5} icon={s.icon} ratio="5 / 4" /></div>
          <div class="svc-copy" data-reveal style="--d:120ms">
            <span class="chip"><Icon name={s.icon} size={16} /> {s.name}</span>
            <h2>{s.title}</h2>
            <p>{s.short}</p>
            <ul>
              {s.features.map((f) => <li><Icon name="check" size={18} /> {f.title}</li>)}
            </ul>
            <a class="btn" href={`/dich-vu/${s.slug}`}>Xem chi tiết <Icon name="arrow" size={18} /></a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section section--dark">
    <div class="container">
      <div class="section-head" data-reveal>
        <h2>Quy trình làm việc</h2>
        <p class="lead">Rõ ràng từ buổi gặp đầu tiên đến khi bàn giao, để bạn luôn biết dự án đang ở đâu.</p>
      </div>
      <Process />
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .list { display: grid; gap: clamp(4rem, 9vw, 7rem); }
  .svc { display: grid; gap: 2.5rem; align-items: center; }
  @media (min-width: 900px) {
    .svc { grid-template-columns: 1fr 1fr; gap: 5rem; }
    .svc.flip > :first-child { order: 2; }
  }
  .svc-copy h2 { margin-top: 1.2rem; font-size: clamp(1.8rem, 1.3rem + 1.8vw, 2.6rem); }
  .svc-copy > p { margin-top: 1rem; color: var(--ink-soft); font-size: 1.08rem; }
  .svc-copy ul { list-style: none; padding: 0; margin: 1.6rem 0 2rem; display: grid; gap: .7rem; }
  .svc-copy li { display: flex; gap: .6rem; align-items: center; font-weight: 500; }
  .svc-copy li :global(svg) { color: var(--tone); flex: none; }
</style>
