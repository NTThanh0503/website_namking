---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import Testimonials from '../components/Testimonials.astro';
import CtaBand from '../components/CtaBand.astro';
---
<BaseLayout title="Dự án" description="Các dự án số hóa, vận hành lưu trú và tổ chức du lịch tiêu biểu.">
  <PageHero
    title="Dự án đã thực hiện"
    lead="Từ phố cổ Hội An đến bản làng Hà Giang, mỗi dự án là một câu chuyện riêng. Chọn lĩnh vực để xem dự án phù hợp với bạn."
    crumbs={[{ label: 'Dự án' }]}
    seed={47}
  />
  <section class="section">
    <div class="container"><ProjectGrid /></div>
  </section>
  <section class="section quotes">
    <div class="container" data-reveal>
      <h2 class="sr-only">Khách hàng nói về chúng tôi</h2>
      <Testimonials />
    </div>
  </section>
  <CtaBand title="Dự án tiếp theo có thể là của bạn" />
</BaseLayout>
<style>
  .quotes { background: var(--ink); color: var(--paper); }
</style>
