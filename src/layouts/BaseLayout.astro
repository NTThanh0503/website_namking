---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getData } from '../data';
import { getLang, langs, locales, ogLocales, switchLangPath } from '../i18n';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}
const lang = getLang(Astro.url);
const { company } = getData(lang);
const { title, description = company.description, image = '/og-image.png' } = Astro.props;
const fullTitle = title ? `${title} | ${company.name}` : `${company.name} – ${company.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
const alternates = langs.map((l) => ({ hreflang: locales[l], href: new URL(switchLangPath(Astro.url.pathname, l), Astro.site) }));
const skip = { vi: 'Bỏ qua, đến nội dung chính', en: 'Skip to main content' }[lang];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={alternates[0].href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#680a12" />
    <meta name="color-scheme" content="light" />

    <!-- Open Graph: hiển thị đẹp khi chia sẻ link lên Facebook, Zalo -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocales[lang]} />
    {langs.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={ogLocales[l]} />)}
    <meta property="og:site_name" content={company.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />

    <!-- Font hỗ trợ tiếng Việt đầy đủ -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Montserrat:wght@800&display=swap"
    />

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'TravelAgency',
      name: company.legalName,
      telephone: company.phone,
      email: company.email,
      address: company.address,
      url: Astro.site?.toString(),
    })} />

    <noscript><style>[data-reveal]{opacity:1!important;transform:none!important}</style></noscript>
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main">{skip}</a>
    <div class="scroll-progress" data-progress aria-hidden="true"></div>
    <Header />
    <main id="main" transition:name="main">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/main.ts';
    </script>
  </body>
</html>
