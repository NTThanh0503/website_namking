---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { company } from '../data/site';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}
const { title, description = company.description, image = '/og-image.png' } = Astro.props;
const fullTitle = title ? `${title} | ${company.name}` : `${company.name} – ${company.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#0c4a57" />

    <!-- Open Graph: hiển thị đẹp khi chia sẻ link lên Facebook, Zalo -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="vi_VN" />
    <meta property="og:site_name" content={company.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />

    <!-- Font hỗ trợ tiếng Việt đầy đủ -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&family=Lora:ital,wght@1,500&display=swap&subset=vietnamese"
    />

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'TravelAgency',
      name: company.legalName,
      telephone: company.phone,
      email: company.email,
      address: company.address,
      url: Astro.site?.toString(),
    })} />

    <noscript><style>[data-reveal]{opacity:1!important;transform:none!important}</style></noscript>
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main">Bỏ qua, đến nội dung chính</a>
    <div class="scroll-progress" data-progress aria-hidden="true"></div>
    <Header />
    <main id="main" transition:name="main">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/main.ts';
    </script>
  </body>
</html>
