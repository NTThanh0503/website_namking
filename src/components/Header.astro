---
import { getData } from '../data';
import { getLang, localizePath } from '../i18n';
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import LangSwitch from './LangSwitch.astro';
const lang = getLang(Astro.url);
const { nav, company } = getData(lang);
const L = (href: string) => localizePath(href, lang);
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' || href === '/en' ? path === href : path.startsWith(href));
const t = {
  vi: { main: 'Điều hướng chính', mobile: 'Điều hướng di động', cta: 'Nhận tư vấn', ctaMobile: 'Nhận tư vấn miễn phí', menu: 'Mở menu' },
  en: { main: 'Main navigation', mobile: 'Mobile navigation', cta: 'Get advice', ctaMobile: 'Get free advice', menu: 'Open menu' },
}[lang];
---
<header class="site-header" data-header transition:persist={`header-${lang}`}>
  <div class="container bar">
    <Logo />
    <nav class="nav" aria-label={t.main}>
      <ul>
        {nav.map((item) => (
          <li><a href={L(item.href)} data-nav aria-current={isActive(L(item.href)) ? 'page' : undefined}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
    <div class="actions">
      <a class="hotline" href={company.phoneHref}><Icon name="phone" size={18} /> {company.phone}</a>
      <LangSwitch />
      <a class="btn btn--primary cta" href={L('/lien-he')}>{t.cta}</a>
      <button class="burger" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
        <span class="sr-only">{t.menu}</span>
        <Icon name="menu" class="i-open" />
        <Icon name="close" class="i-close" />
      </button>
    </div>
  </div>

  <div class="mobile" id="mobile-menu" data-mobile-menu hidden>
    <nav class="container" aria-label={t.mobile}>
      <ul>
        {nav.map((item, i) => (
          <li style={`--i:${i}`}><a href={L(item.href)} data-nav aria-current={isActive(L(item.href)) ? 'page' : undefined}>{item.label}</a></li>
        ))}
      </ul>
      <div class="mobile-foot">
        <a class="btn btn--primary" href={L('/lien-he')}>{t.ctaMobile}</a>
        <a class="btn btn--ghost" href={company.phoneHref}><Icon name="phone" size={18} /> {company.phone}</a>
      </div>
    </nav>
  </div>
</header>
<style>
  .site-header { position: sticky; top: 0; z-index: 50; border-bottom: 1px solid transparent; transition: background-color .4s, border-color .4s, backdrop-filter .4s; }
  .site-header.is-scrolled { background: rgba(5, 7, 13, .72); backdrop-filter: blur(16px) saturate(1.4); -webkit-backdrop-filter: blur(16px) saturate(1.4); border-bottom-color: var(--line); }
  .bar { height: var(--header-h); display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; transition: height .4s var(--ease-out); }
  .is-scrolled .bar { height: 64px; }

  .nav ul { display: flex; gap: .25rem; list-style: none; margin: 0; padding: 0; }
  .nav a { display: block; padding: .5rem .85rem; border-radius: 999px; text-decoration: none; font-weight: 500; font-size: .97rem; color: var(--ink-soft); transition: color .2s, background-color .2s; }
  .nav a:hover { color: var(--ink); background: rgba(47, 124, 255, .08); }
  .nav a[aria-current='page'] { color: var(--ink); background: rgba(47, 124, 255, .12); box-shadow: inset 0 0 0 1px rgba(92, 160, 255, .3); }

  .actions { display: flex; align-items: center; gap: 1rem; }
  @media (max-width: 900px) { .actions { gap: .6rem; } }
  .hotline { display: inline-flex; align-items: center; gap: .4rem; text-decoration: none; font-weight: 600; font-size: .95rem; color: var(--cyan); white-space: nowrap; }
  .cta { min-height: 44px; padding: .6rem 1.15rem; font-size: .92rem; }

  .burger { display: none; width: 46px; height: 46px; border-radius: 50%; border: 0; background: rgba(255,255,255,.04); box-shadow: inset 0 0 0 1px var(--line); color: var(--ink); cursor: pointer; place-items: center; }
  .burger :global(.i-close) { display: none; }
  .burger[aria-expanded='true'] :global(.i-close) { display: block; }
  .burger[aria-expanded='true'] :global(.i-open) { display: none; }

  .mobile { position: fixed; inset: 0; top: 0; z-index: -1; background: var(--paper); padding-top: calc(var(--header-h) + 1.5rem); overflow-y: auto; }
  .mobile ul { list-style: none; margin: 0; padding: 0; }
  .mobile li { border-bottom: 1px solid var(--line); opacity: 0; transform: translateY(14px); }
  .mobile.is-open li { animation: menu-in .55s var(--ease-out) forwards; animation-delay: calc(var(--i) * 45ms); }
  .mobile a[data-nav] { display: block; padding: 1rem 0; font-family: var(--font-display); font-size: 1.6rem; font-weight: 600; letter-spacing: -0.02em; text-decoration: none; }
  .mobile a[aria-current='page'] { color: var(--cyan); text-shadow: 0 0 20px rgba(92,225,255,.5); }
  .mobile-foot { display: grid; gap: .8rem; margin-top: 2rem; padding-bottom: 2rem; }
  .mobile-foot .btn { justify-content: center; }
  @keyframes menu-in { to { opacity: 1; transform: none; } }

  @media (max-width: 1180px) { .hotline { display: none; } }
  @media (max-width: 900px) {
    .nav, .cta { display: none; }
    .burger { display: grid; }
  }
</style>

<style is:global>
  .site-header.menu-open { backdrop-filter: none !important; -webkit-backdrop-filter: none !important; background: var(--paper); box-shadow: none; }
  html.menu-locked { overflow: hidden; }
</style>
