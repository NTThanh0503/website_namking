---
import { nav, company } from '../data/site';
import Logo from './Logo.astro';
import Icon from './Icon.astro';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<header class="site-header" data-header transition:persist>
  <div class="container bar">
    <Logo />
    <nav class="nav" aria-label="Điều hướng chính">
      <ul>
        {nav.map((item) => (
          <li><a href={item.href} data-nav aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
    <div class="actions">
      <a class="hotline" href={company.phoneHref}><Icon name="phone" size={18} /> {company.phone}</a>
      <a class="btn btn--primary cta" href="/lien-he">Nhận tư vấn</a>
      <button class="burger" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
        <span class="sr-only">Mở menu</span>
        <Icon name="menu" class="i-open" />
        <Icon name="close" class="i-close" />
      </button>
    </div>
  </div>

  <div class="mobile" id="mobile-menu" data-mobile-menu hidden>
    <nav class="container" aria-label="Điều hướng di động">
      <ul>
        {nav.map((item, i) => (
          <li style={`--i:${i}`}><a href={item.href} data-nav aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a></li>
        ))}
      </ul>
      <div class="mobile-foot">
        <a class="btn btn--primary" href="/lien-he">Nhận tư vấn miễn phí</a>
        <a class="btn btn--ghost" href={company.phoneHref}><Icon name="phone" size={18} /> {company.phone}</a>
      </div>
    </nav>
  </div>
</header>

<style>
  .site-header { position: sticky; top: 0; z-index: 50; transition: background-color .4s, box-shadow .4s, backdrop-filter .4s; }
  .site-header.is-scrolled { background: color-mix(in srgb, var(--paper) 86%, transparent); backdrop-filter: blur(14px) saturate(1.4); -webkit-backdrop-filter: blur(14px) saturate(1.4); box-shadow: 0 1px 0 var(--mist); }
  .bar { height: var(--header-h); display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; transition: height .4s var(--ease-out); }
  .is-scrolled .bar { height: 64px; }

  .nav ul { display: flex; gap: .25rem; list-style: none; margin: 0; padding: 0; }
  .nav a { display: block; padding: .5rem .85rem; border-radius: 999px; text-decoration: none; font-weight: 500; font-size: .97rem; color: var(--ink-soft); transition: color .2s, background-color .2s; }
  .nav a:hover { color: var(--ink); background: color-mix(in srgb, var(--mist) 70%, transparent); }
  .nav a[aria-current='page'] { color: var(--ink); background: var(--mist); }

  .actions { display: flex; align-items: center; gap: 1rem; }
  .hotline { display: inline-flex; align-items: center; gap: .4rem; text-decoration: none; font-weight: 600; color: var(--lagoon); white-space: nowrap; }
  .cta { padding: .7rem 1.2rem; }

  .burger { display: none; width: 46px; height: 46px; border-radius: 50%; border: 0; background: var(--ink); color: var(--paper); cursor: pointer; place-items: center; }
  .burger :global(.i-close) { display: none; }
  .burger[aria-expanded='true'] :global(.i-close) { display: block; }
  .burger[aria-expanded='true'] :global(.i-open) { display: none; }

  .mobile { position: fixed; inset: 0; top: 0; z-index: -1; background: var(--paper); padding-top: calc(var(--header-h) + 1.5rem); overflow-y: auto; }
  .mobile ul { list-style: none; margin: 0; padding: 0; }
  .mobile li { border-bottom: 1px solid var(--mist); opacity: 0; transform: translateY(14px); }
  .mobile.is-open li { animation: menu-in .55s var(--ease-out) forwards; animation-delay: calc(var(--i) * 45ms); }
  .mobile a[data-nav] { display: block; padding: 1rem 0; font-size: 1.6rem; font-weight: 600; letter-spacing: -0.02em; text-decoration: none; }
  .mobile a[aria-current='page'] { color: var(--jade); }
  .mobile-foot { display: grid; gap: .8rem; margin-top: 2rem; padding-bottom: 2rem; }
  .mobile-foot .btn { justify-content: center; }
  @keyframes menu-in { to { opacity: 1; transform: none; } }

  @media (max-width: 1080px) { .hotline { display: none; } }
  @media (max-width: 900px) {
    .nav, .cta { display: none; }
    .burger { display: grid; }
  }
</style>

<style is:global>
  .site-header.menu-open { backdrop-filter: none !important; -webkit-backdrop-filter: none !important; background: var(--paper); box-shadow: none; }
  html.menu-locked { overflow: hidden; }
</style>
