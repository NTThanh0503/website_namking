---
// Nút chọn ngôn ngữ VI / EN. Dẫn sang đúng trang hiện tại ở ngôn ngữ còn lại.
// Đường dẫn được cập nhật lại sau mỗi lần chuyển trang trong src/scripts/main.ts
import { getLang, langs, languages, switchLangPath } from '../i18n';
const lang = getLang(Astro.url);
const label = { vi: 'Chọn ngôn ngữ', en: 'Choose language' }[lang];
---
<div class="lang" role="group" aria-label={label}>
  {langs.map((l) => (
    <a
      href={switchLangPath(Astro.url.pathname, l)}
      hreflang={l}
      lang={l}
      data-lang-link={l}
      aria-current={l === lang ? 'true' : undefined}
      title={languages[l]}
    >
      <span aria-hidden="true">{l.toUpperCase()}</span>
      <span class="sr-only">{languages[l]}</span>
    </a>
  ))}
</div>

<style>
  .lang { position: relative; display: inline-flex; align-items: center; padding: 3px; border-radius: 999px; background: var(--white); box-shadow: inset 0 0 0 1px var(--line); }
  .lang a {
    display: grid; place-items: center; min-width: 40px; height: 36px; padding-inline: .6rem; border-radius: 999px;
    font-family: var(--font-mono); font-size: .78rem; font-weight: 500; letter-spacing: .06em; text-decoration: none;
    color: var(--ink-soft); transition: color .25s, background-color .25s, box-shadow .25s;
  }
  .lang a:hover { color: var(--ink); }
  .lang a[aria-current='true'] { color: var(--btn-fg); background: var(--btn-bg); box-shadow: 0 6px 14px -8px rgba(74, 7, 13, .7); }
  .lang a:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
</style>
