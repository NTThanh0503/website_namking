---
import { services } from '../data/site';
import Icon from './Icon.astro';
import ArtTile from './ArtTile.astro';
---
<div class="tabs" data-tabs style="--active:0">
  <div class="tablist" role="tablist" aria-label="Lĩnh vực dịch vụ">
    {services.map((s, i) => (
      <button role="tab" id={`tab-${s.slug}`} aria-controls={`panel-${s.slug}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} class={`tone-${s.tone}`}>
        <span class="t-icon"><Icon name={s.icon} size={22} /></span>
        <span class="t-text"><strong>{s.name}</strong><small>{s.title}</small></span>
      </button>
    ))}
    <span class="indicator" aria-hidden="true"></span>
  </div>

  {services.map((s, i) => (
    <div role="tabpanel" id={`panel-${s.slug}`} aria-labelledby={`tab-${s.slug}`} hidden={i !== 0} class={`panel tone-${s.tone}`}>
      <div class="panel-copy">
        <h3>{s.title}</h3>
        <p>{s.intro}</p>
        <ul class="features">
          {s.features.map((f) => (
            <li><Icon name="check" size={18} /> <span><strong>{f.title}.</strong> {f.text}</span></li>
          ))}
        </ul>
        <a class="btn btn--primary" href={`/dich-vu/${s.slug}`}>Tìm hiểu dịch vụ {s.name.toLowerCase()} <Icon name="arrow" size={18} /></a>
      </div>
      <ArtTile tone={s.tone} seed={i * 13 + 5} icon={s.icon} ratio="4 / 5" />
    </div>
  ))}
</div>

<style>
  .tablist { position: relative; display: grid; grid-template-columns: repeat(3, 1fr); gap: .5rem; padding: .5rem; border-radius: 22px; background: rgba(5, 7, 13, .6); box-shadow: inset 0 0 0 1px var(--line); }
  .indicator { position: absolute; top: .5rem; bottom: .5rem; left: .5rem; width: calc((100% - 2rem) / 3); border-radius: 16px; background: linear-gradient(180deg, rgba(47, 124, 255, .18), rgba(47, 124, 255, .05)); box-shadow: inset 0 0 0 1px rgba(92, 160, 255, .5), 0 0 40px -12px var(--electric); transform: translateX(calc(var(--active) * (100% + .5rem))); transition: transform .6s var(--ease-out); }
  [role='tab'] { position: relative; z-index: 1; display: flex; align-items: center; gap: .9rem; text-align: left; padding: .9rem 1rem; border: 0; background: none; border-radius: 16px; cursor: pointer; color: var(--ink-soft); transition: color .3s; }
  [role='tab'][aria-selected='true'] { color: var(--ink); }
  .t-icon { flex: none; display: grid; place-items: center; width: 44px; height: 44px; border-radius: 13px; background: var(--tone-soft); color: var(--tone); transition: transform .5s var(--ease-out); }
  [role='tab'][aria-selected='true'] .t-icon { transform: rotate(-6deg) scale(1.06); }
  .t-text strong { display: block; font-size: 1.1rem; }
  .t-text small { display: block; font-size: .82rem; line-height: 1.35; }

  .panel { display: grid; gap: 2.5rem; align-items: center; margin-top: 2.5rem; animation: panel-in .7s var(--ease-out); }
  @media (min-width: 900px) { .panel { grid-template-columns: 1.2fr .8fr; gap: 4rem; } }
  .panel[hidden] { display: none; }
  @keyframes panel-in { from { opacity: 0; transform: translateY(12px); } }
  .panel-copy > p { margin-top: 1rem; color: var(--ink-soft); max-width: 40rem; }
  .features { list-style: none; padding: 0; margin: 1.8rem 0 2rem; display: grid; gap: 1rem; }
  .features li { display: grid; grid-template-columns: 22px 1fr; gap: .6rem; }
  .features :global(svg) { margin-top: .25rem; color: var(--tone); filter: drop-shadow(0 0 6px var(--tone)); }
  .features li { color: var(--ink-soft); }
  .features strong { color: var(--ink); }

  @media (max-width: 760px) {
    .panel :global(.art) { aspect-ratio: 16 / 9 !important; }
    .t-text small { display: none; }
    [role='tab'] { flex-direction: column; text-align: center; gap: .4rem; padding: .8rem .4rem; }
    .t-text strong { font-size: .95rem; }
  }
</style>
