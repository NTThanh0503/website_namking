  eye: '<path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/>',
  facebook: '<path d="M14 21v-7h2.5l.5-3H14V9.2c0-.9.3-1.5 1.6-1.5H17V5.1A19 19 0 0 0 14.9 5C12.7 5 11 6.3 11 8.8V11H8.5v3H11v7"/>',
