---
import { partners } from '../data/site';
const list = [...partners, ...partners];
---
<div class="marquee" aria-label="Các kênh và nền tảng chúng tôi kết nối">
  <ul class="track">
    {list.map((p, i) => <li aria-hidden={i >= partners.length ? 'true' : undefined}>{p}</li>)}
  </ul>
</div>
<style>
  .marquee { overflow: hidden; -webkit-mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent); mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent); }
  .track { display: flex; width: max-content; gap: 3.5rem; list-style: none; margin: 0; padding: 0; animation: scroll 38s linear infinite; }
  .marquee:hover .track { animation-play-state: paused; }
  li { font-size: 1.5rem; font-weight: 700; letter-spacing: -0.02em; color: var(--ink-soft); opacity: .55; white-space: nowrap; }
  @keyframes scroll { to { transform: translateX(calc(-50% - 1.75rem)); } }
  @media (prefers-reduced-motion: reduce) { .track { animation: none; flex-wrap: wrap; width: auto; } li[aria-hidden] { display: none; } }
</style>
