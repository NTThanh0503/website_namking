---
import { getLang } from '../i18n';
import { getData } from '../data';
const lang = getLang(Astro.url);
const { partners } = getData(lang);
const label = { vi: 'Các loại điểm đến chúng tôi phục vụ', en: 'The kinds of destinations we serve' }[lang];
const list = [...partners, ...partners];
---
<div class="marquee" aria-label={label}>
  <ul class="track">
    {list.map((p, i) => <li aria-hidden={i >= partners.length ? 'true' : undefined}><span class="sep" aria-hidden="true">◆</span>{p}</li>)}
  </ul>
</div>
<style>
  .marquee { overflow: hidden; -webkit-mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent); mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent); }
  .track { display: flex; width: max-content; gap: 2rem; list-style: none; margin: 0; padding: 0; animation: scroll 38s linear infinite; }
  .marquee:hover .track { animation-play-state: paused; }
  li { font-family: var(--font-display); font-size: .98rem; font-weight: 600; letter-spacing: -0.02em; color: #b3a2a3; white-space: nowrap; transition: color .3s; }
  li:hover { color: var(--maroon); }
  li .sep { margin-right: .8rem; font-size: .6em; vertical-align: middle; color: var(--crimson); opacity: .6; }
  @keyframes scroll { to { transform: translateX(calc(-50% - 1rem)); } }
  @media (prefers-reduced-motion: reduce) { .track { animation: none; flex-wrap: wrap; width: auto; } li[aria-hidden] { display: none; } }
</style>
