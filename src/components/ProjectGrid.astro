---
import { getLang } from '../i18n';
import { getData } from '../data';
import ProjectCard from './ProjectCard.astro';
interface Props { limit?: number; filter?: boolean }
const { limit, filter = true } = Astro.props;
const lang = getLang(Astro.url);
const { projects, services } = getData(lang);
const t = { vi: { filter: 'Lọc dự án theo lĩnh vực', all: 'Tất cả', unit: 'dự án' }, en: { filter: 'Filter projects by area', all: 'All', unit: 'projects' } }[lang];
const list = limit ? projects.slice(0, limit) : projects;
---
<div data-filter>
  {filter && (
    <div class="filters" role="group" aria-label={t.filter}>
      <button type="button" data-filter-btn="all" aria-pressed="true">{t.all}</button>
      {services.map((s) => <button type="button" data-filter-btn={s.slug} aria-pressed="false">{s.name}</button>)}
      <span class="count" data-filter-count data-unit={t.unit} aria-live="polite">{list.length} {t.unit}</span>
    </div>
  )}
  <div class="grid">
    {list.map((p, i) => (
      <div class="cell" data-reveal style={`--d:${(i % 3) * 90}ms`} data-cat={p.category}>
        <ProjectCard project={p} index={i} />
      </div>
    ))}
  </div>
</div>
<style>
  .filters { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem; margin-bottom: 2.5rem; }
  .filters button { padding: .55rem 1.1rem; border-radius: 999px; border: 0; background: var(--white); min-height: 44px; box-shadow: inset 0 0 0 1px var(--line); cursor: pointer; font-weight: 600; font-size: .95rem; transition: background-color .25s, color .25s; }
  .filters button:hover { background: rgba(47, 124, 255, .1); }
  .filters button[aria-pressed='true'] { background: rgba(47, 124, 255, .18); color: #fff; box-shadow: inset 0 0 0 1px rgba(92, 160, 255, .6), 0 0 24px -8px var(--electric); }
  .count { margin-left: auto; font-size: var(--fs-sm); color: var(--ink-soft); }
  .grid { display: grid; gap: 1.5rem; grid-template-columns: 1fr; }
  @media (min-width: 700px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1040px) { .grid { grid-template-columns: repeat(3, 1fr); } }
  .cell.is-hidden { display: none; }
  .cell.pop { animation: pop .55s var(--ease-out); }
  @keyframes pop { from { opacity: 0; transform: translateY(16px) scale(.98); } }
</style>
