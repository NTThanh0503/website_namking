---
import { projects, services } from '../data/site';
import ProjectCard from './ProjectCard.astro';
interface Props { limit?: number; filter?: boolean }
const { limit, filter = true } = Astro.props;
const list = limit ? projects.slice(0, limit) : projects;
---
<div data-filter>
  {filter && (
    <div class="filters" role="group" aria-label="Lọc dự án theo lĩnh vực">
      <button type="button" data-filter-btn="all" aria-pressed="true">Tất cả</button>
      {services.map((s) => <button type="button" data-filter-btn={s.slug} aria-pressed="false">{s.name}</button>)}
      <span class="count" data-filter-count aria-live="polite">{list.length} dự án</span>
    </div>
  )}
  <div class="grid">
    {list.map((p, i) => (
      <div class="cell" data-reveal style={`--d:${(i % 3) * 90}ms`} data-cat={p.category}>
        <ProjectCard project={p} index={i} />
      </div>
    ))}
  </div>
</div>
<style>
  .filters { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem; margin-bottom: 2.5rem; }
  .filters button { padding: .55rem 1.1rem; border-radius: 999px; border: 0; background: var(--white); box-shadow: inset 0 0 0 1px var(--mist); cursor: pointer; font-weight: 600; font-size: .95rem; transition: background-color .25s, color .25s; }
  .filters button:hover { background: var(--mist); }
  .filters button[aria-pressed='true'] { background: var(--ink); color: var(--paper); box-shadow: none; }
  .count { margin-left: auto; font-size: var(--fs-sm); color: var(--ink-soft); }
  .grid { display: grid; gap: 3rem 2rem; grid-template-columns: 1fr; }
  @media (min-width: 700px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1040px) { .grid { grid-template-columns: repeat(3, 1fr); } }
  .cell.is-hidden { display: none; }
  .cell.pop { animation: pop .55s var(--ease-out); }
  @keyframes pop { from { opacity: 0; transform: translateY(16px) scale(.98); } }
</style>
