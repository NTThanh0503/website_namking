---
// Phần đầu cho các trang con
import { contourPaths } from '../lib/contours';
import { getLang, localizePath } from '../i18n';
interface Props { title: string; lead?: string; crumbs?: { label: string; href?: string }[]; seed?: number }
const { title, lead, crumbs = [], seed = 11 } = Astro.props;
const lang = getLang(Astro.url);
const t = { vi: { crumbs: 'Đường dẫn', home: 'Trang chủ' }, en: { crumbs: 'Breadcrumb', home: 'Home' } }[lang];
const lines = contourPaths({ width: 800, height: 360, lines: 12, seed, amplitude: 26 });
---
<section class="page-hero" data-hero>
  <div class="grid-bg" aria-hidden="true"></div>
  <!-- Mạng điểm dữ liệu trôi nhẹ (vẽ bởi src/scripts/pagoda.ts) -->
  <canvas class="net" data-network aria-hidden="true"></canvas>
  <div class="orb" style="width:520px;height:520px;top:-300px;right:-120px;opacity:.16" aria-hidden="true"></div>
  <svg class="art" viewBox="0 0 800 360" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    {lines.map((d, i) => <path d={d} pathLength="1" style={`--i:${i}`} />)}
  </svg>
  <div class="container inner">
    {crumbs.length > 0 && (
      <nav aria-label={t.crumbs} class="crumbs">
        <ol>
          <li><a href={localizePath('/', lang)}>{t.home}</a></li>
          {crumbs.map((c) => <li>{c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}</li>)}
        </ol>
      </nav>
    )}
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
</section>
<style>
  .page-hero { position: relative; overflow: hidden; padding-block: clamp(2.25rem, 5vw, 4rem) clamp(2.25rem, 4.5vw, 3.5rem); border-bottom: 1px solid var(--line); background: linear-gradient(180deg, var(--surface), var(--paper)); }
  .art { position: absolute; right: -5%; top: 0; width: min(70%, 900px); height: 100%; fill: none; stroke: var(--maroon); stroke-width: 1.1; -webkit-mask-image: linear-gradient(90deg, transparent, #000 40%); mask-image: linear-gradient(90deg, transparent, #000 40%); }
  .art path { opacity: calc(.1 + var(--i) * .03); stroke-dasharray: 1; stroke-dashoffset: 1; transition: stroke-dashoffset 2s var(--ease-out); transition-delay: calc(var(--i) * 50ms); }
  :global(.is-ready) .art path { stroke-dashoffset: 0; }
  .net { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
  .inner { position: relative; }
  h1 { font-size: clamp(2rem, 1.3rem + 2.4vw, 3.2rem); max-width: 20ch; }
  .lead { margin-top: 1rem; }
  .crumbs ol { display: flex; flex-wrap: wrap; gap: .5rem; list-style: none; padding: 0; margin: 0 0 1.2rem; font-size: var(--fs-sm); color: var(--ink-soft); }
  .crumbs li + li::before { content: '/'; margin-right: .5rem; opacity: .5; }
  .crumbs a { text-decoration: none; }
  .crumbs a:hover { color: var(--accent); text-decoration: underline; }
  h1 { color: var(--maroon); }
  @media (prefers-reduced-motion: reduce) { .art path { stroke-dashoffset: 0; } }
</style>
