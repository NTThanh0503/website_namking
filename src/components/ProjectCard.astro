---
import type { Project } from '../data/site';
import { getLang } from '../i18n';
import { getData } from '../data';
import ArtTile from './ArtTile.astro';
import Icon from './Icon.astro';
interface Props { project: Project; index?: number }
const { project: p, index = 0 } = Astro.props;
const { services } = getData(getLang(Astro.url));
const svc = services.find((s) => s.slug === p.category)!;
---
<article class:list={['card', `tone-${svc.tone}`]}>
  <ArtTile image={p.image} alt={p.title} tone={svc.tone} seed={index * 17 + 3} />
  <div class="body">
    <div class="meta"><span class="chip">{svc.name}</span><span class="loc"><Icon name="pin" size={15} /> {p.location}, {p.year}</span></div>
    <h3>{p.title}</h3>
    <p>{p.summary}</p>
    <p class="result"><Icon name="check" size={16} /> {p.result}</p>
  </div>
</article>
<style>
  .card { display: flex; flex-direction: column; gap: .9rem; height: 100%; padding: .5rem .5rem 1.1rem; border-radius: calc(var(--radius-m) + .6rem); background: var(--surface); box-shadow: inset 0 0 0 1px var(--line); transition: transform .45s var(--ease-out), box-shadow .45s var(--ease-out); }
  .card:hover { transform: translateY(-6px); box-shadow: var(--glow); }
  .body { padding-inline: .75rem; }
  .card:hover :global(.art svg), .card:hover :global(.art img) { transform: scale(1.06); }
  .meta { display: flex; flex-wrap: wrap; align-items: center; gap: .8rem; font-size: var(--fs-sm); color: var(--ink-soft); }
  .loc { display: inline-flex; align-items: center; gap: .3rem; }
  h3 { margin-top: .6rem; font-size: 1.08rem; }
  .body > p { margin-top: .35rem; color: var(--ink-soft); font-size: .92rem; }
  .result { display: flex; align-items: center; gap: .4rem; margin-top: .8rem !important; padding-top: .7rem; font-size: .9rem; border-top: 1px solid var(--line); font-weight: 600; color: var(--tone) !important; }
</style>
