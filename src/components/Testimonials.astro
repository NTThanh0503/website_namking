---
import { getLang } from '../i18n';
import { getData } from '../data';
const lang = getLang(Astro.url);
const { testimonials } = getData(lang);
const t = {
  vi: { label: 'Thông điệp của Nam Kinh Digital', dot: (n: string) => `Xem thông điệp ${n.toLowerCase()}`, prev: 'Thông điệp trước', next: 'Thông điệp tiếp theo' },
  en: { label: 'Messages from Nam Kinh Digital', dot: (n: string) => `Read the message ${n.toLowerCase()}`, prev: 'Previous message', next: 'Next message' },
}[lang];
import Icon from './Icon.astro';
---
<div class="slider" data-slider aria-roledescription="carousel" aria-label={t.label}>
  <div class="viewport">
    <div class="track" data-track>
      {testimonials.map((t, i) => (
        <figure class="slide" data-slide aria-roledescription="slide" aria-label={`${i + 1} / ${testimonials.length}`}>
          <blockquote>{t.quote}</blockquote>
          <figcaption><strong>{t.name}</strong><span>{t.role}</span></figcaption>
        </figure>
      ))}
    </div>
  </div>
  <div class="controls">
    <div class="dots">
      {testimonials.map((item, i) => <button type="button" data-dot aria-label={t.dot(item.name)} aria-current={i === 0 ? 'true' : 'false'}></button>)}
    </div>
    <div class="arrows">
      <button type="button" data-prev aria-label={t.prev}><Icon name="left" /></button>
      <button type="button" data-next aria-label={t.next}><Icon name="right" /></button>
    </div>
  </div>
</div>
<style>
  .viewport { overflow: hidden; }
  .track { display: flex; transition: transform .8s var(--ease-out); touch-action: pan-y; cursor: grab; }
  .slide { flex: 0 0 100%; margin: 0; padding-right: 2rem; }
  blockquote { margin: 0; font-family: var(--font-display); font-weight: 500; font-size: clamp(1.1rem, .95rem + .7vw, 1.5rem); line-height: 1.45; letter-spacing: -0.01em; max-width: 52rem; }
  figcaption { margin-top: 1.2rem; display: grid; gap: .1rem; }
  figcaption strong { font-family: var(--font-mono); font-size: .8rem; font-weight: 500; letter-spacing: .1em; text-transform: uppercase; color: var(--accent); }
  blockquote::before { content: '“'; display: block; height: .55em; font-family: var(--font-brand); font-size: 3em; line-height: 1; color: var(--maroon); opacity: .25; }
  figcaption span { color: var(--ink-soft); font-size: .95rem; }
  .controls { display: flex; align-items: center; justify-content: space-between; margin-top: 1.5rem; }
  .dots { display: flex; gap: .5rem; }
  .dots button { width: 28px; height: 6px; border-radius: 6px; border: 0; padding: 0; cursor: pointer; background: color-mix(in srgb, currentColor 25%, transparent); transition: width .5s var(--ease-out), background-color .3s; }
  .dots button[aria-current='true'] { width: 56px; background: var(--maroon); }
  .arrows { display: flex; gap: .6rem; }
  .arrows button { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; border: 0; cursor: pointer; background: transparent; color: inherit; box-shadow: inset 0 0 0 1.5px color-mix(in srgb, currentColor 40%, transparent); transition: background-color .25s, color .25s; }
  .arrows button:hover { color: var(--ivory); background: var(--maroon); box-shadow: inset 0 0 0 1.5px var(--maroon); }
</style>
