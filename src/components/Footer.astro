---
import { company, nav, services } from '../data/site';
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { contourPaths } from '../lib/contours';
const lines = contourPaths({ width: 1400, height: 260, lines: 9, seed: 41, amplitude: 22 });
const year = new Date().getFullYear();
---
<footer class="footer">
  <svg class="footer-art" viewBox="0 0 1400 260" preserveAspectRatio="none" aria-hidden="true">
    {lines.map((d, i) => <path d={d} style={`opacity:${0.08 + i * 0.03}`} />)}
  </svg>
  <div class="container grid">
    <div class="brand">
      <Logo light />
      <p>{company.description}</p>
      <ul class="socials">
        {company.socials.map((s) => (
          <li><a href={s.href} target="_blank" rel="noopener" aria-label={s.name}><Icon name={s.icon} size={20} /></a></li>
        ))}
      </ul>
    </div>
    <div>
      <h2 class="f-title">Dịch vụ</h2>
      <ul class="f-list">
        {services.map((s) => <li><a href={`/dich-vu/${s.slug}`}>{s.title}</a></li>)}
      </ul>
    </div>
    <div>
      <h2 class="f-title">Công ty</h2>
      <ul class="f-list">
        {nav.slice(1).map((n) => <li><a href={n.href}>{n.label}</a></li>)}
      </ul>
    </div>
    <div>
      <h2 class="f-title">Liên hệ</h2>
      <ul class="f-list f-contact">
        <li><Icon name="pin" size={18} /> <span>{company.address}</span></li>
        <li><Icon name="phone" size={18} /> <a href={company.phoneHref}>{company.phone}</a></li>
        <li><Icon name="mail" size={18} /> <a href={`mailto:${company.email}`}>{company.email}</a></li>
        <li><Icon name="clock" size={18} /> <span>{company.hours}</span></li>
      </ul>
    </div>
  </div>
  <div class="container bottom">
    <p>© {year} {company.legalName}. MST: {company.taxCode}</p>
    <button class="to-top" type="button" data-to-top><Icon name="up" size={18} /> Lên đầu trang</button>
  </div>
</footer>

<style>
  .footer { position: relative; background: var(--ink); color: color-mix(in srgb, var(--paper) 80%, transparent); padding-top: clamp(4rem, 8vw, 6rem); overflow: hidden; }
  .footer-art { position: absolute; inset: 0 0 auto 0; width: 100%; height: 220px; fill: none; stroke: var(--mist); stroke-width: 1; pointer-events: none; }
  .grid { position: relative; display: grid; gap: 2.5rem; grid-template-columns: 1fr; }
  @media (min-width: 720px) { .grid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1024px) { .grid { grid-template-columns: 1.5fr 1.2fr .8fr 1.3fr; gap: 3rem; } }
  .brand p { margin-top: 1.2rem; max-width: 26rem; font-size: .97rem; }
  .socials { display: flex; gap: .6rem; list-style: none; padding: 0; margin: 1.5rem 0 0; }
  .socials a { display: grid; place-items: center; width: 42px; height: 42px; border-radius: 50%; color: var(--paper); box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--paper) 25%, transparent); transition: background-color .25s, color .25s; }
  .socials a:hover { background: var(--lantern); color: var(--ink); box-shadow: none; }
  .f-title { font-size: 1rem; letter-spacing: 0; color: var(--paper); margin-bottom: 1rem; }
  .f-list { list-style: none; padding: 0; margin: 0; display: grid; gap: .7rem; font-size: .96rem; }
  .f-list a { text-decoration: none; transition: color .2s; }
  .f-list a:hover { color: var(--lantern); }
  .f-contact li { display: grid; grid-template-columns: 18px 1fr; gap: .7rem; align-items: start; }
  .f-contact :global(svg) { margin-top: .2rem; color: var(--lantern); }
  .bottom { position: relative; display: flex; flex-wrap: wrap; gap: 1rem; justify-content: space-between; align-items: center; margin-top: 4rem; padding-block: 1.6rem; border-top: 1px solid color-mix(in srgb, var(--paper) 14%, transparent); font-size: .88rem; }
  .to-top { display: inline-flex; align-items: center; gap: .4rem; background: none; border: 0; cursor: pointer; color: var(--paper); font-weight: 600; font-size: .9rem; }
  .to-top:hover { color: var(--lantern); }
</style>
