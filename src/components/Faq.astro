---
import { getLang } from '../i18n';
import { getData } from '../data';
const { faqs } = getData(getLang(Astro.url));
import Icon from './Icon.astro';
---
<div class="faq">
  {faqs.map((f, i) => (
    <details name="faq" open={i === 0}>
      <summary><span>{f.q}</span><span class="plus"><Icon name="plus" size={20} /></span></summary>
      <div class="answer"><p>{f.a}</p></div>
    </details>
  ))}
</div>
<style>
  .faq { border-top: 1px solid var(--line); }
  details { border-bottom: 1px solid var(--line); }
  summary { display: flex; justify-content: space-between; align-items: center; gap: 1.5rem; padding: 1rem 0; cursor: pointer; list-style: none; font-weight: 600; font-size: 1rem; transition: color .25s; }
  summary:hover { color: var(--accent); }
  summary::-webkit-details-marker { display: none; }
  .plus { flex: none; display: grid; place-items: center; width: 34px; height: 34px; border-radius: 50%; color: var(--ink-soft); box-shadow: inset 0 0 0 1px var(--line); transition: transform .45s var(--ease-out), color .3s, background-color .3s, box-shadow .3s; }
  details[open] .plus { transform: rotate(45deg); color: var(--btn-fg); background: var(--btn-bg); box-shadow: none; }
  summary:hover .plus { color: var(--accent); box-shadow: inset 0 0 0 1px var(--accent-line); }
  .answer { padding: 0 3rem 1.1rem 0; font-size: .95rem; color: var(--ink-soft); }
  details::details-content { block-size: 0; overflow: hidden; transition: block-size .45s var(--ease-out), content-visibility .45s allow-discrete; }
  details[open]::details-content { block-size: auto; }
</style>
