---
import { getLang, localizePath } from '../i18n';
import { getData } from '../data';
import { NK_PATH, NK_VIEWBOX } from '../lib/brand';
const lang = getLang(Astro.url);
const { company } = getData(lang);
const home = { vi: 'Trang chủ', en: 'Home' }[lang];
interface Props { light?: boolean }
const { light = false } = Astro.props;
// Biểu tượng "nk" tô một màu theo currentColor: nền sáng → đỏ đô, nền tối (light) → ngà
---
<a href={localizePath('/', lang)} class:list={['logo', { 'logo--light': light }]} aria-label={`${company.name} – ${home}`}>
  <svg class="logo-mark" viewBox={NK_VIEWBOX} width="44" height="35" aria-hidden="true">
    <path d={NK_PATH} fill="currentColor" fill-rule="evenodd" />
  </svg>
  <span class="logo-text">{company.name}</span>
</a>

<style>
  .logo { --logo: var(--maroon); display: inline-flex; align-items: center; gap: .7rem; text-decoration: none; color: var(--logo); }
  .logo--light { --logo: var(--ivory); }
  .logo-mark { flex: none; transition: transform .5s var(--ease-out); animation: logo-in .9s var(--ease-out) both; }
  .logo:hover .logo-mark { transform: translateY(-2px) rotate(-3deg); }
  /* Chữ logo: Montserrat đậm như logo gốc, vệt sáng lướt qua khi rê chuột */
  .logo-text {
    font-family: var(--font-brand); font-weight: 800; font-size: 1.02rem; letter-spacing: .01em; line-height: 1; white-space: nowrap;
    background: linear-gradient(100deg, var(--logo) 40%, var(--logo-shine, #c9505b) 50%, var(--logo) 60%) 100% 0 / 300% 100%;
    -webkit-background-clip: text; background-clip: text; color: transparent; -webkit-text-fill-color: transparent;
    transition: background-position 1s var(--ease-out);
  }
  .logo--light .logo-text { --logo-shine: #ffffff; }
  .logo:hover .logo-text { background-position: 0 0; }
  @keyframes logo-in { from { opacity: 0; transform: translateY(6px) scale(.92); } }
  @media (max-width: 380px) { .logo-text { font-size: .9rem; } }
</style>
