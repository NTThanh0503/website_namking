---
import { company } from '../data/site';
interface Props { light?: boolean }
const { light = false } = Astro.props;
---
<a href="/" class:list={['logo', { 'logo--light': light }]} aria-label={`${company.name} – Trang chủ`}>
  <svg viewBox="0 0 40 40" width="38" height="38" aria-hidden="true">
    <rect width="40" height="40" rx="11" fill="currentColor" class="logo-bg" />
    <path d="M8 26c5-6 9-6 12 0s7 6 12 0" fill="none" stroke="#F2B33D" stroke-width="3.2" stroke-linecap="round" />
    <path d="M8 17c5-6 9-6 12 0s7 6 12 0" fill="none" stroke="#DDEAE6" stroke-width="3.2" stroke-linecap="round" opacity=".85" />
  </svg>
  <span>{company.name}</span>
</a>

<style>
  .logo { display: inline-flex; align-items: center; gap: .65rem; text-decoration: none; font-weight: 700; font-size: 1.15rem; letter-spacing: -0.02em; color: var(--lagoon); }
  .logo span { color: var(--ink); }
  .logo--light span { color: var(--paper); }
  .logo--light { color: color-mix(in srgb, var(--paper) 14%, transparent); }
</style>
