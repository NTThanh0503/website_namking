---
import { company } from '../data/site';
interface Props { light?: boolean }
const { light = false } = Astro.props;
---
<a href="/" class:list={['logo', { 'logo--light': light }]} aria-label={`${company.name} – Trang chủ`}>
  <svg viewBox="0 0 34 34" width="36" height="36" aria-hidden="true">
    <rect x=".5" y=".5" width="33" height="33" rx="10" fill="#0a1230" stroke="#2f6bff" stroke-opacity=".6" />
    <path class="logo-path" d="M9 23 L15 13 L19 19 L25 10" fill="none" stroke="#5ce1ff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
    <circle cx="25" cy="10" r="2.6" fill="#5ce1ff" class="logo-dot" />
  </svg>
  <span>{company.name}</span>
</a>

<style>
  .logo { display: inline-flex; align-items: center; gap: .7rem; text-decoration: none; font-family: var(--font-display); font-weight: 700; font-size: 1.18rem; letter-spacing: -0.015em; color: var(--ink); }
  .logo svg { transition: filter .4s; }
  .logo:hover svg { filter: drop-shadow(0 0 10px rgba(92, 225, 255, .6)); }
  .logo-path { stroke-dasharray: 40; stroke-dashoffset: 40; animation: logo-draw 1.4s var(--ease-out) .2s forwards; }
  .logo-dot { animation: blink 2.4s ease-in-out infinite; }
  @keyframes logo-draw { to { stroke-dashoffset: 0; } }
</style>
