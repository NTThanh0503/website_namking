---
import { getLang, localizePath } from '../i18n';
import { getData } from '../data';
const lang = getLang(Astro.url);
const { company } = getData(lang);
const t = {
  vi: { title: 'Bắt đầu hành trình số cho cơ sở của bạn', text: 'Gửi vài thông tin cơ bản, chuyên viên sẽ gọi lại trong 24 giờ để khảo sát và đề xuất phương án phù hợp. Tư vấn không mất phí.', send: 'Gửi yêu cầu tư vấn', call: 'Gọi' },
  en: { title: 'Start the digital journey for your property', text: 'Share a few basic details and a consultant will call you back within 24 hours to assess your needs and propose the right plan. Consultation is free.', send: 'Request a consultation', call: 'Call' },
}[lang];
import Icon from './Icon.astro';
import { contourPaths } from '../lib/contours';
interface Props { title?: string; text?: string }
const { title = t.title, text = t.text } = Astro.props;
const lines = contourPaths({ width: 1200, height: 420, lines: 12, seed: 77, amplitude: 30 });
---
<section class="section">
  <div class="container">
    <div class="band on-dark" data-reveal>
      <div class="grid-bg" aria-hidden="true"></div>
      <div class="grain" aria-hidden="true"></div>
      <svg viewBox="0 0 1200 420" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
        {lines.map((d, i) => <path d={d} style={`opacity:${0.08 + i * 0.025}`} />)}
      </svg>
      <div class="inner">
        <h2>{title}</h2>
        <p>{text}</p>
        <div class="row">
          <a class="btn btn--primary" href={localizePath('/lien-he', lang)}>{t.send}</a>
          <a class="btn btn--ghost" href={company.phoneHref}><Icon name="phone" size={18} /> {t.call} {company.phone}</a>
        </div>
      </div>
    </div>
  </div>
</section>
<style>
  .band { position: relative; overflow: hidden; border-radius: var(--radius-l); color: var(--ink); padding: clamp(2.5rem, 6vw, 5rem) clamp(1.5rem, 6vw, 5rem); background: radial-gradient(120% 140% at 80% 0%, #9a2330 0%, var(--maroon) 45%, var(--maroon-deep) 100%); box-shadow: 0 40px 100px -40px rgba(74, 7, 13, .75); }
  svg { position: absolute; inset: 0; width: 100%; height: 100%; fill: none; stroke: var(--blush); stroke-width: 1; }
  .inner { position: relative; max-width: 40rem; }
  p { margin-top: 1.2rem; color: var(--ink-soft); font-size: var(--fs-lg); }
  .row { display: flex; flex-wrap: wrap; gap: .8rem; margin-top: 2rem; }
</style>
