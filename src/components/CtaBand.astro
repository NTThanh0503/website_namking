---
import { company } from '../data/site';
import Icon from './Icon.astro';
import { contourPaths } from '../lib/contours';
interface Props { title?: string; text?: string }
const {
  title = 'Bắt đầu hành trình số cho cơ sở của bạn',
  text = 'Gửi vài thông tin cơ bản, chuyên viên sẽ gọi lại trong 24 giờ để khảo sát và đề xuất phương án phù hợp. Tư vấn không mất phí.',
} = Astro.props;
const lines = contourPaths({ width: 1200, height: 420, lines: 12, seed: 77, amplitude: 30 });
---
<section class="section">
  <div class="container">
    <div class="band" data-reveal>
      <svg viewBox="0 0 1200 420" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
        {lines.map((d, i) => <path d={d} style={`opacity:${0.08 + i * 0.025}`} />)}
      </svg>
      <div class="inner">
        <h2>{title}</h2>
        <p>{text}</p>
        <div class="row">
          <a class="btn btn--primary" href="/lien-he">Gửi yêu cầu tư vấn</a>
          <a class="btn btn--ghost" href={company.phoneHref}><Icon name="phone" size={18} /> Gọi {company.phone}</a>
        </div>
      </div>
    </div>
  </div>
</section>
<style>
  .band { position: relative; overflow: hidden; border-radius: var(--radius-l); background: var(--ink); color: var(--paper); padding: clamp(2.5rem, 6vw, 5rem); }
  svg { position: absolute; inset: 0; width: 100%; height: 100%; fill: none; stroke: var(--lantern); stroke-width: 1.2; }
  .inner { position: relative; max-width: 40rem; }
  p { margin-top: 1.2rem; opacity: .82; font-size: var(--fs-lg); }
  .row { display: flex; flex-wrap: wrap; gap: .8rem; margin-top: 2rem; }
</style>
