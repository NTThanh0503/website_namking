---
import Icon from './Icon.astro';
import { getLang, localizePath } from '../i18n';
import { getData } from '../data';
const lang = getLang(Astro.url);
const L = (href: string) => localizePath(href, lang);
const { company } = getData(lang);

// Ba điểm dịch vụ trên sơ đồ quỹ đạo (theo viewBox 520 x 520)
const t = {
  vi: {
    nodes: [['Tham quan ảo 360°', 'Phố cổ Hội An'], ['Vận hành lưu trú', 'Resort Phú Quốc'], ['Tour trải nghiệm', 'Bản làng Hà Giang']],
    headline: ['Số hóa điểm đến.', 'Lấp đầy phòng nghỉ.', 'Dẫn lối hành trình.'],
    pill: `Chuyển đổi số cho ngành du lịch Việt · từ ${company.founded}`,
    cta: 'Nhận tư vấn miễn phí', projects: 'Xem dự án đã làm',
    trust: 'Hơn 120 khách sạn, homestay và điểm đến đã đồng hành',
    visual: 'Minh họa: ba mảng dịch vụ số hóa, lưu trú và du lịch kết nối quanh một trung tâm',
  },
  en: {
    nodes: [['360° virtual tours', 'Hoi An Old Town'], ['Hospitality operations', 'Phu Quoc resort'], ['Experiential tours', 'Ha Giang villages']],
    headline: ['Digitize destinations.', 'Fill every room.', 'Guide the journey.'],
    pill: `Digital transformation for Vietnam’s travel industry · since ${company.founded}`,
    cta: 'Get free advice', projects: 'See our projects',
    trust: 'Trusted by 120+ hotels, homestays and destinations',
    visual: 'Illustration: digital, hospitality and travel services connected around a central hub',
  },
}[lang];
const nodes = [
  { x: 118, y: 132, icon: 'scan', title: t.nodes[0][0], place: t.nodes[0][1], pos: 'left:0%; top:9%' },
  { x: 418, y: 196, icon: 'bed', title: t.nodes[1][0], place: t.nodes[1][1], pos: 'right:-2%; top:30%' },
  { x: 196, y: 424, icon: 'compass', title: t.nodes[2][0], place: t.nodes[2][1], pos: 'left:14%; bottom:3%' },
];
const headline = t.headline;
---

<section class="hero" data-hero>
  <div class="grid-bg" aria-hidden="true"></div>
  <div class="orb" style="width:620px;height:620px;top:-280px;left:50%;margin-left:-60px" aria-hidden="true"></div>
  <div class="orb" style="width:380px;height:380px;bottom:-160px;left:-160px;opacity:.16;animation-delay:-4s" aria-hidden="true"></div>
  <div class="scan-line" aria-hidden="true"></div>

  <div class="container hero-grid">
    <div class="copy">
      <p class="pill reveal-up" style="--i:0"><span class="pulse-dot"></span>{t.pill}</p>
      <h1>
        {headline.map((line, i) => (
          <span class="line" style={`--i:${i}`}><span>{line}</span></span>
        ))}
      </h1>
      <p class="lead reveal-up" style="--i:3">{company.description}</p>
      <div class="cta-row reveal-up" style="--i:4">
        <a class="btn btn--primary" href={L('/lien-he')}>{t.cta} <Icon name="arrow" size={18} /></a>
        <a class="btn btn--ghost" href={L('/du-an')}>{t.projects}</a>
      </div>
      <p class="trust reveal-up" style="--i:5"><Icon name="check" size={18} /> {t.trust}</p>
    </div>

    <div class="visual" role="img" aria-label={t.visual}>
      <svg class="layer" data-depth="8" viewBox="0 0 520 520" fill="none" aria-hidden="true">
        <defs>
          <radialGradient id="hero-core" cx="50%" cy="50%" r="50%">
            <stop offset="0%" stop-color="#5ce1ff" stop-opacity=".9" />
            <stop offset="40%" stop-color="#2f6bff" stop-opacity=".45" />
            <stop offset="100%" stop-color="#2f6bff" stop-opacity="0" />
          </radialGradient>
          <linearGradient id="hero-sweep" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0%" stop-color="#5ce1ff" stop-opacity="0" />
            <stop offset="100%" stop-color="#5ce1ff" stop-opacity=".35" />
          </linearGradient>
        </defs>
        <circle class="ring" style="--i:0" cx="260" cy="260" r="240" stroke="#2f6bff" stroke-opacity=".2" />
        <circle class="ring spin" style="--i:1" cx="260" cy="260" r="180" stroke="#2f6bff" stroke-opacity=".3" stroke-dasharray="2 6" />
        <circle class="ring spin-rev" style="--i:2" cx="260" cy="260" r="120" stroke="#5ce1ff" stroke-opacity=".32" stroke-dasharray="40 14" />
        <circle class="ring" style="--i:3" cx="260" cy="260" r="60" stroke="#5ce1ff" stroke-opacity=".45" />
        <g class="sweep"><path d="M260 260 L500 260 A240 240 0 0 0 467.8 140 Z" fill="url(#hero-sweep)" /></g>
        <circle class="core" cx="260" cy="260" r="110" fill="url(#hero-core)" />
        <circle cx="260" cy="260" r="9" fill="#e8f9ff" />
        <g class="spin"><circle cx="260" cy="80" r="4" fill="#5ce1ff" /></g>
        <g class="spin-rev"><circle cx="380" cy="260" r="3" fill="#8fb4ff" /></g>
      </svg>
      <svg class="layer" data-depth="16" viewBox="0 0 520 520" fill="none" aria-hidden="true">
        <path class="route" d="M118 132 Q 300 60 418 196 T 196 424" stroke="#2f6bff" stroke-opacity=".55" stroke-dasharray="3 7" />
        {nodes.map((n, i) => (
          <g style={`--i:${i}`}>
            <path class="link-line" d={`M260 260 L${n.x} ${n.y}`} stroke="#5ce1ff" stroke-width="1.5" />
            <circle class="node-ring" cx={n.x} cy={n.y} r="22" fill="#0a1230" stroke="#5ce1ff" stroke-opacity=".7" />
            <circle class="node-ping" cx={n.x} cy={n.y} r="22" stroke="#5ce1ff" />
            <circle cx={n.x} cy={n.y} r="6" fill="#5ce1ff" />
          </g>
        ))}
      </svg>
      <div class="layer tags" data-depth="26">
        {nodes.map((n, i) => (
          <div class="tag" style={`--i:${i}; ${n.pos}`}>
            <span class="tag-icon"><Icon name={n.icon} size={18} /></span>
            <span><strong>{n.title}</strong><small>{n.place}</small></span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .hero { position: relative; padding-block: clamp(3rem, 8vw, 6.5rem) clamp(4rem, 8vw, 7rem); overflow: hidden; }
  .hero-grid { position: relative; display: grid; gap: clamp(2.5rem, 5vw, 4.5rem); align-items: center; }
  @media (min-width: 980px) { .hero-grid { grid-template-columns: 1.1fr .9fr; } }

  .copy { display: flex; flex-direction: column; align-items: flex-start; }
  h1 { margin-top: 1.6rem; font-size: clamp(2.5rem, 1.1rem + 4.4vw, 4.9rem); letter-spacing: -0.04em; line-height: 1.02; }
  .line { display: block; overflow: hidden; padding-bottom: .08em; }
  .line > span { display: block; transform: translateY(105%); transition: transform 1.1s var(--ease-out); transition-delay: calc(var(--i) * 110ms + 150ms); }
  .line:nth-child(2) > span { color: var(--cyan); text-shadow: 0 0 32px rgba(92, 225, 255, .45); }
  .line:nth-child(3) > span { color: #b9c8ee; }
  .is-ready .line > span { transform: none; }

  .reveal-up { opacity: 0; transform: translateY(16px); filter: blur(4px); transition: opacity .9s var(--ease-out), transform .9s var(--ease-out), filter .9s var(--ease-out); transition-delay: calc(var(--i) * 90ms + 250ms); }
  .is-ready .reveal-up { opacity: 1; transform: none; filter: none; }
  .copy .lead { margin-top: 1.6rem; max-width: 34rem; }
  .cta-row { display: flex; flex-wrap: wrap; gap: .8rem; margin-top: 2.2rem; }
  .trust { display: flex; align-items: center; gap: .5rem; margin-top: 2rem; font-size: var(--fs-sm); color: var(--ink-soft); }
  .trust :global(svg) { color: var(--cyan); }

  /* ---------- Sơ đồ quỹ đạo ---------- */
  .visual { position: relative; width: 100%; max-width: 560px; margin-inline: auto; aspect-ratio: 1; opacity: 0; transform: scale(.94); transition: opacity 1.2s var(--ease-out) .3s, transform 1.4s var(--ease-out) .3s; }
  .is-ready .visual { opacity: 1; transform: none; }
  .layer { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; transition: transform .9s var(--ease-out); }

  .spin, .spin-rev { transform-box: view-box; transform-origin: 260px 260px; animation: spin 28s linear infinite; }
  .spin-rev { animation-duration: 40s; animation-direction: reverse; }
  .sweep { transform-box: view-box; transform-origin: 260px 260px; animation: spin 6s linear infinite; }
  .core { transform-box: fill-box; transform-origin: center; animation: core 4s ease-in-out infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }
  @keyframes core { 50% { transform: scale(1.08); opacity: .75; } }

  .link-line { stroke-dasharray: 6 10; opacity: 0; transition: opacity .8s calc(.9s + var(--i) * .2s); animation: dash 1.6s linear infinite; }
  .is-ready .link-line { opacity: 1; }
  @keyframes dash { to { stroke-dashoffset: -32; } }
  .node-ping { transform-box: fill-box; transform-origin: center; animation: ping 2.6s cubic-bezier(0, 0, .2, 1) infinite; animation-delay: calc(var(--i) * .7s); }
  @keyframes ping { from { transform: scale(1); opacity: .7; } to { transform: scale(2.2); opacity: 0; } }

  .tag {
    position: absolute; display: flex; align-items: center; gap: .65rem;
    padding: .5rem .9rem .5rem .5rem; border-radius: 14px; white-space: nowrap;
    background: rgba(10, 15, 30, .82); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
    box-shadow: inset 0 0 0 1px var(--line), 0 16px 40px -16px #000;
    opacity: 0; translate: 0 10px;
    transition: opacity .8s var(--ease-out), translate .8s var(--ease-out);
    transition-delay: calc(1.1s + var(--i) * .25s);
    animation: float 6s ease-in-out infinite; animation-delay: calc(var(--i) * -2s);
  }
  .is-ready .tag { opacity: 1; translate: 0 0; }
  @keyframes float { 50% { transform: translateY(-8px); } }
  .tag-icon { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 10px; color: var(--cyan); background: rgba(92, 225, 255, .1); box-shadow: inset 0 0 0 1px rgba(92, 225, 255, .3); }
  .tag strong { display: block; font-size: .88rem; line-height: 1.25; }
  .tag small { display: block; font-size: .75rem; color: var(--ink-soft); }

  @media (max-width: 520px) {
    .tag { padding: .35rem .6rem .35rem .35rem; gap: .45rem; }
    .tag-icon { width: 28px; height: 28px; }
    .tag strong { font-size: .76rem; }
    .tag small { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .line > span, .reveal-up, .visual, .tag { transform: none !important; translate: none !important; opacity: 1 !important; filter: none !important; }
    .link-line { opacity: 1; }
  }
</style>
