---
import Icon from './Icon.astro';
import { contourPaths } from '../lib/contours';
import { company } from '../data/site';

const contours = contourPaths({ width: 600, height: 640, lines: 17, seed: 19, amplitude: 34 });
// Toạ độ 3 điểm trên bản đồ (theo viewBox 600 x 640)
const pins = [
  { x: 140, y: 500, icon: 'scan', title: 'Tham quan ảo 360°', place: 'Phố cổ Hội An', tone: 'lagoon' },
  { x: 330, y: 318, icon: 'bed', title: 'Đặt phòng trực tiếp', place: 'Homestay Đà Lạt', tone: 'jade' },
  { x: 470, y: 138, icon: 'compass', title: 'Tour bản làng', place: 'Hà Giang', tone: 'lantern' },
];
const route = `M ${pins[0].x} ${pins[0].y} C 210 420, 250 360, ${pins[1].x} ${pins[1].y} S 420 230, ${pins[2].x} ${pins[2].y}`;
const headline = ['Số hóa điểm đến.', 'Lấp đầy phòng nghỉ.', 'Dẫn lối hành trình.'];
---

<section class="hero" data-hero>
  <div class="container hero-grid">
    <div class="copy">
      <h1>
        {headline.map((line, i) => (
          <span class="line" style={`--i:${i}`}><span>{line}</span></span>
        ))}
      </h1>
      <p class="lead">{company.description}</p>
      <div class="cta-row">
        <a class="btn btn--primary" href="/lien-he">Nhận tư vấn miễn phí</a>
        <a class="btn btn--ghost" href="/du-an">Xem dự án đã làm</a>
      </div>
      <p class="trust"><Icon name="check" size={18} /> Hơn 120 khách sạn, homestay và điểm đến đã đồng hành</p>
    </div>

    <div class="map" aria-label="Minh họa: hành trình kết nối ba mảng dịch vụ số hóa, lưu trú và du lịch" role="img">
      <svg class="layer contours" data-depth="8" viewBox="0 0 600 640" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
        {contours.map((d, i) => <path d={d} pathLength="1" style={`--i:${i}`} />)}
      </svg>
      <svg class="layer route" data-depth="16" viewBox="0 0 600 640" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
        <path class="route-base" d={route} pathLength="1" />
        <path class="route-flow" d={route} />
        {pins.map((p, i) => (
          <g class="dot" style={`--i:${i}; transform-origin:${p.x}px ${p.y}px`}>
            <circle class="pulse" cx={p.x} cy={p.y} r="16" />
            <circle cx={p.x} cy={p.y} r="7" />
          </g>
        ))}
      </svg>
      <div class="layer cards" data-depth="26">
        {pins.map((p, i) => (
          <div class:list={['pin-card', `tone-${p.tone}`]} style={`--i:${i}; left:${(p.x / 600) * 100}%; top:${(p.y / 640) * 100}%`}>
            <span class="pin-icon"><Icon name={p.icon} size={20} /></span>
            <span><strong>{p.title}</strong><small>{p.place}</small></span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .hero { position: relative; padding-block: clamp(2rem, 5vw, 4rem) clamp(4rem, 8vw, 7rem); overflow: hidden; }
  .hero-grid { display: grid; gap: clamp(2.5rem, 5vw, 4rem); align-items: center; }
  @media (min-width: 980px) { .hero-grid { grid-template-columns: 1.25fr .9fr; } }

  h1 { color: var(--ink); font-size: clamp(2.5rem, 1.2rem + 3.6vw, 4.15rem); letter-spacing: -0.04em; }
  .line { display: block; overflow: hidden; padding-bottom: .06em; }
  .line > span { display: block; transform: translateY(105%); transition: transform 1s var(--ease-out); transition-delay: calc(var(--i) * 110ms + 100ms); }
  .line:nth-child(2) > span { color: var(--jade); }
  .line:nth-child(3) > span { color: var(--lagoon); }
  .is-ready .line > span { transform: none; }

  .copy .lead { margin-top: 1.6rem; }
  .copy .lead, .cta-row, .trust { opacity: 0; transform: translateY(14px); transition: opacity .8s var(--ease-out), transform .8s var(--ease-out); transition-delay: .55s; }
  .cta-row { display: flex; flex-wrap: wrap; gap: .8rem; margin-top: 2rem; transition-delay: .65s; }
  .trust { display: flex; align-items: center; gap: .5rem; margin-top: 2rem; font-size: var(--fs-sm); color: var(--ink-soft); transition-delay: .75s; }
  .trust :global(svg) { color: var(--jade); }
  .is-ready .copy .lead, .is-ready .cta-row, .is-ready .trust { opacity: 1; transform: none; }

  /* ---------- Bản đồ ---------- */
  .map { position: relative; aspect-ratio: 600 / 640; border-radius: var(--radius-l); background: radial-gradient(120% 90% at 80% 10%, #13606f 0%, var(--lagoon) 55%, #093a45 100%); overflow: hidden; box-shadow: 0 40px 80px -40px rgba(12, 74, 87, .55); }
  .layer { position: absolute; inset: -14px; width: calc(100% + 28px); height: calc(100% + 28px); transition: transform .9s var(--ease-out); }

  .contours path { fill: none; stroke: var(--mist); stroke-width: 1.1; opacity: calc(.12 + var(--i) * .018); stroke-dasharray: 1; stroke-dashoffset: 1; transition: stroke-dashoffset 2.4s var(--ease-out); transition-delay: calc(var(--i) * 60ms); }
  .is-ready .contours path { stroke-dashoffset: 0; }

  .route-base { fill: none; stroke: var(--lantern); stroke-width: 2.5; stroke-linecap: round; stroke-dasharray: 1; stroke-dashoffset: 1; opacity: .35; transition: stroke-dashoffset 1.8s var(--ease-out) 1.1s; }
  .is-ready .route-base { stroke-dashoffset: 0; }
  .route-flow { fill: none; stroke: var(--lantern); stroke-width: 2.5; stroke-linecap: round; stroke-dasharray: 2 12; opacity: 0; transition: opacity .6s 2.6s; }
  .is-ready .route-flow { opacity: 1; animation: flow 1.6s linear infinite; }
  @keyframes flow { to { stroke-dashoffset: -28; } }

  .dot { fill: var(--lantern); transform: scale(0); transition: transform .7s cubic-bezier(.34, 1.56, .64, 1); transition-delay: calc(1.2s + var(--i) * .45s); }
  .is-ready .dot { transform: scale(1); }
  .pulse { fill: var(--lantern); opacity: .35; transform-box: fill-box; transform-origin: center; animation: pulse 2.6s ease-out infinite; animation-delay: calc(var(--i) * .5s); }
  @keyframes pulse { 0% { transform: scale(.4); opacity: .5; } 100% { transform: scale(2.2); opacity: 0; } }

  .pin-card {
    position: absolute; display: flex; align-items: center; gap: .7rem;
    padding: .6rem 1rem .6rem .6rem; border-radius: 16px; background: var(--paper);
    box-shadow: 0 18px 40px -18px rgba(5, 30, 36, .6);
    transform: translate(-12%, calc(-100% - 22px)) scale(.9); opacity: 0;
    transition: opacity .6s var(--ease-out), transform .8s var(--ease-out);
    transition-delay: calc(1.35s + var(--i) * .45s);
    white-space: nowrap;
  }
  .is-ready .pin-card { opacity: 1; transform: translate(-12%, calc(-100% - 22px)); }
  .pin-card:nth-child(1) { transform-origin: left bottom; }
  .pin-icon { display: grid; place-items: center; width: 38px; height: 38px; border-radius: 11px; background: var(--tone-soft); color: var(--tone); }
  .pin-card strong { display: block; font-size: .93rem; line-height: 1.2; }
  .pin-card small { display: block; font-size: .8rem; color: var(--ink-soft); }
  .pin-card:last-child { transform: translate(-70%, calc(-100% - 22px)) scale(.9); }
  .is-ready .pin-card:last-child { transform: translate(-70%, calc(-100% - 22px)); }

  @media (max-width: 520px) {
    .pin-card { padding: .45rem .7rem .45rem .45rem; gap: .5rem; }
    .pin-icon { width: 30px; height: 30px; }
    .pin-card strong { font-size: .8rem; }
    .pin-card small { font-size: .7rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .line > span, .copy .lead, .cta-row, .trust, .pin-card, .dot { transform: none !important; opacity: 1 !important; }
    .contours path, .route-base { stroke-dashoffset: 0 !important; }
    .route-flow { opacity: 1; }
  }
</style>
