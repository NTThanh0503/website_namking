---
import Icon from './Icon.astro';
import { getLang, localizePath } from '../i18n';
import { getData } from '../data';
const lang = getLang(Astro.url);
const L = (href: string) => localizePath(href, lang);
const { company } = getData(lang);

// Ba tầng giá trị hiển thị quanh mô hình Chùa Một Cột
const t = {
  vi: {
    nodes: [['Số hóa', 'Tham quan ảo 360°, bản đồ số'], ['Kết nối thương mại', 'Đặt dịch vụ trực tuyến'], ['Dữ liệu & hệ sinh thái', 'Mạng lưới điểm đến số']],
    headline: ['Số hóa điểm đến.', 'Kết nối trải nghiệm.', 'Gia tăng giá trị.'],
    pill: `${company.brand} · ${company.positioning}`,
    lead: 'Đưa điểm đến, sản phẩm và dịch vụ du lịch lên môi trường số, để du khách khám phá, đặt trải nghiệm và chủ điểm đến quản lý kinh doanh trên một nền tảng.',
    cta: 'Nhận tư vấn miễn phí', projects: 'Khám phá giải pháp',
    trust: 'Dành cho di tích, bảo tàng, làng nghề, khu du lịch và cơ sở lưu trú',
    visual: 'Mô hình 3D Chùa Một Cột dạng khung dây số đang được quét số hóa, quanh là ba tầng giá trị: số hóa, kết nối thương mại, dữ liệu',
  },
  en: {
    nodes: [['Digitize', '360° tours, digital maps'], ['Commercial connection', 'Online booking'], ['Data & ecosystem', 'A network of digital destinations']],
    headline: ['Digitize destinations.', 'Connect experiences.', 'Add value.'],
    pill: `${company.brand} · ${company.positioning}`,
    lead: 'We bring destinations, travel products and services online, so travellers can discover and book experiences and owners can run their business on one platform.',
    cta: 'Get free advice', projects: 'Explore solutions',
    trust: 'For heritage sites, museums, craft villages, tourist areas and accommodation',
    visual: 'A 3D wireframe model of Hanoi’s One Pillar Pagoda being digitally scanned, surrounded by three value tiers: digitize, commercial connection, data',
  },
}[lang];
const nodes = [
  { icon: 'scan', title: t.nodes[0][0], place: t.nodes[0][1], pos: 'left:-10%; top:0%' },
  { icon: 'ticket', title: t.nodes[1][0], place: t.nodes[1][1], pos: 'right:-12%; top:62%' },
  { icon: 'chart', title: t.nodes[2][0], place: t.nodes[2][1], pos: 'left:-6%; bottom:-2%' },
];
const headline = t.headline;
---

<section class="hero on-dark brand-bg" data-hero>
  <div class="orb" style="width:620px;height:620px;top:-280px;left:50%;margin-left:-60px" aria-hidden="true"></div>
  <div class="orb orb--violet" style="width:520px;height:520px;bottom:-220px;left:-180px;animation-delay:-4s" aria-hidden="true"></div>
  <div class="orb orb--cyan" style="width:420px;height:420px;top:-120px;left:-140px;animation-delay:-2s" aria-hidden="true"></div>
  <!-- Nền 3D: Chùa Một Cột khung dây số (vẽ bởi src/scripts/pagoda.ts, căn theo khối .visual) -->
  <canvas class="pagoda-bg" data-pagoda aria-hidden="true"></canvas>
  <div class="grid-bg" aria-hidden="true"></div>
  <div class="grid-hot" aria-hidden="true"></div>
  <div class="grain" aria-hidden="true"></div>
  <div class="vignette" aria-hidden="true"></div>

  <div class="container hero-grid">
    <div class="copy">
      <p class="pill reveal-up" style="--i:0"><span class="pulse-dot"></span>{t.pill}</p>
      <h1>
        {headline.map((line, i) => (
          <span class="line" style={`--i:${i}`}><span class:list={[{ 'shine-text': i === 1 }]}>{line}</span></span>
        ))}
      </h1>
      <p class="lead reveal-up" style="--i:3">{t.lead}</p>
      <div class="cta-row reveal-up" style="--i:4">
        <a class="btn btn--primary" href={L('/lien-he')}>{t.cta} <Icon name="arrow" size={18} /></a>
        <a class="btn btn--ghost" href={L('/dich-vu')}>{t.projects}</a>
      </div>
      <p class="trust reveal-up" style="--i:5"><Icon name="check" size={18} /> {t.trust}</p>
    </div>

    <div class="visual" role="img" aria-label={t.visual} data-pagoda-anchor>
      <div class="layer tags" data-depth="26">
        {nodes.map((n, i) => (
          <div class="tag" style={`--i:${i}; ${n.pos}`}>
            <span class="tag-icon"><Icon name={n.icon} size={18} /></span>
            <span><strong>{n.title}</strong><small>{n.place}</small></span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .hero { position: relative; padding-block: clamp(2.5rem, 5vw, 3.5rem); overflow: hidden; }
  .hero-grid { position: relative; display: grid; gap: clamp(2rem, 4vw, 3.5rem); align-items: center; }
  /* Máy tính: phần đầu trang vừa đúng một màn hình, không phải cuộn mới thấy hết */
  @media (min-width: 980px) {
    .hero { display: flex; align-items: center; min-height: calc(100svh - var(--header-h)); max-height: 900px; }
    .hero-grid { grid-template-columns: 1.05fr .95fr; }
  }

  .copy { display: flex; flex-direction: column; align-items: flex-start; }
  h1 { margin-top: 1rem; font-size: clamp(1.9rem, .9rem + 2.4vw, 3.1rem); letter-spacing: -0.035em; line-height: 1.04; }
  .line { display: block; overflow: hidden; padding-bottom: .08em; }
  .line > span { display: block; transform: translateY(105%); transition: transform 1.1s var(--ease-out); transition-delay: calc(var(--i) * 110ms + 150ms); }
  /* Dòng 2 dùng .shine-text (global.css): chữ hồng phấn có vệt sáng trắng lướt qua */
  .line:nth-child(3) > span { color: var(--ink-soft); }
  .is-ready .line > span { transform: none; }

  .reveal-up { opacity: 0; transform: translateY(16px); filter: blur(4px); transition: opacity .9s var(--ease-out), transform .9s var(--ease-out), filter .9s var(--ease-out); transition-delay: calc(var(--i) * 90ms + 250ms); }
  .is-ready .reveal-up { opacity: 1; transform: none; filter: none; }
  .copy .lead { margin-top: 1rem; max-width: 31rem; font-size: 1rem; }
  .cta-row { display: flex; flex-wrap: wrap; gap: .7rem; margin-top: 1.6rem; }
  .trust { display: flex; align-items: center; gap: .5rem; margin-top: 1.4rem; font-size: var(--fs-sm); color: var(--ink-soft); }
  .trust :global(svg) { color: var(--accent); }

  /* ---------- Sơ đồ quỹ đạo ---------- */
  /* Khối .visual chỉ giữ chỗ và đặt nhãn; mô hình 3D vẽ trên canvas phủ toàn phần đầu trang */
  .visual { position: relative; width: 100%; max-width: min(500px, calc(100svh - var(--header-h) - 7rem)); min-width: 280px; margin-inline: auto; aspect-ratio: 1; }
  .pagoda-bg { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; opacity: 0; transition: opacity 1.6s var(--ease-out) .2s; }
  .is-ready .pagoda-bg { opacity: 1; }
  .layer { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; transition: transform .9s var(--ease-out); }

  .tag {
    position: absolute; display: flex; align-items: center; gap: .65rem;
    padding: .5rem .9rem .5rem .5rem; border-radius: 14px; white-space: nowrap;
    background: rgba(44, 5, 9, .62); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
    box-shadow: inset 0 0 0 1px var(--line), 0 16px 40px -16px rgba(20, 2, 4, .8);
    opacity: 0; translate: 0 10px;
    transition: opacity .8s var(--ease-out), translate .8s var(--ease-out);
    transition-delay: calc(1.1s + var(--i) * .25s);
    animation: float 6s ease-in-out infinite; animation-delay: calc(var(--i) * -2s);
  }
  .is-ready .tag { opacity: 1; translate: 0 0; }
  @keyframes float { 50% { transform: translateY(-8px); } }
  .tag-icon { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 10px; color: var(--accent); background: var(--accent-soft); box-shadow: inset 0 0 0 1px var(--accent-line); }
  .tag strong { display: block; font-size: .88rem; line-height: 1.25; }
  .tag small { display: block; font-size: .75rem; color: var(--ink-soft); }

  /* Màn hình hẹp: kéo nhãn vào trong để không bị cắt mép */
  @media (max-width: 979px) {
    .tag:nth-child(1) { left: 0 !important; }
    .tag:nth-child(2) { right: 0 !important; }
    .tag:nth-child(3) { left: 2% !important; }
  }
  @media (max-width: 520px) {
    .tag { padding: .35rem .6rem .35rem .35rem; gap: .45rem; }
    .tag-icon { width: 28px; height: 28px; }
    .tag strong { font-size: .76rem; }
    .tag small { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .line > span, .reveal-up, .tag { transform: none !important; translate: none !important; opacity: 1 !important; filter: none !important; }
    .pagoda-bg { opacity: 1; }
  }
</style>
