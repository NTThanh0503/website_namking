---
import { process } from '../data/site';
---
<ol class="process">
  {process.map((p, i) => (
    <li data-reveal style={`--d:${i * 120}ms`}>
      <span class="num">{i + 1}</span>
      <h3>{p.title}</h3>
      <p>{p.text}</p>
    </li>
  ))}
</ol>
<style>
  .process { list-style: none; padding: 0; margin: 0; display: grid; gap: 2rem; counter-reset: s; }
  @media (min-width: 820px) { .process { grid-template-columns: repeat(4, 1fr); gap: 1.5rem; } }
  li { position: relative; padding: 5.4rem 1.5rem 1.6rem; border-radius: var(--radius-m); background: rgba(10, 15, 30, .7); box-shadow: inset 0 0 0 1px var(--line); transition: transform .45s var(--ease-out), box-shadow .45s var(--ease-out); }
  li:hover { transform: translateY(-4px); box-shadow: var(--glow); }
  li::before { content: ''; position: absolute; top: 46px; left: 72px; right: -1.5rem; height: 1px; z-index: 1; background: linear-gradient(90deg, transparent, var(--cyan), transparent) no-repeat, var(--line); background-size: 40% 100%, 100% 100%; animation: travel 3.2s ease-in-out infinite; }
  @keyframes travel { from { background-position: -80% 0, 0 0; } to { background-position: 180% 0, 0 0; } }
  li:last-child::before { display: none; }
  @media (max-width: 819px) { li::before { display: none; } }
  .num { position: absolute; top: 1.5rem; left: 1.5rem; display: grid; place-items: center; width: 46px; height: 46px; border-radius: 12px; font-family: var(--font-mono); font-size: .9rem; color: var(--cyan); background: rgba(92, 225, 255, .08); box-shadow: inset 0 0 0 1px rgba(92, 225, 255, .35); }
  h3 { font-size: 1.3rem; }
  p { margin-top: .5rem; color: var(--ink-soft); font-size: .98rem; }
</style>
