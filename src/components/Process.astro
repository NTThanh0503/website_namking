---
import { getLang } from '../i18n';
import { getData } from '../data';
const { process } = getData(getLang(Astro.url));
---
<ol class="process">
  {process.map((p, i) => (
    <li data-reveal style={`--d:${i * 120}ms`}>
      <span class="num">{i + 1}</span>
      <h3>{p.title}</h3>
      <p>{p.text}</p>
    </li>
  ))}
</ol>
<style>
  .process { list-style: none; padding: 0; margin: 0; display: grid; gap: 2rem; counter-reset: s; }
  @media (min-width: 820px) { .process { grid-template-columns: repeat(4, 1fr); gap: 1.5rem; } }
  li { position: relative; padding: 4.1rem 1.2rem 1.2rem; border-radius: var(--radius-m); background: var(--surface); box-shadow: inset 0 0 0 1px var(--line); transition: transform .45s var(--ease-out), box-shadow .45s var(--ease-out); }
  li:hover { transform: translateY(-4px); box-shadow: var(--glow); }
  li::before { content: ''; position: absolute; top: 37px; left: 62px; right: -1.5rem; height: 1px; z-index: 1; background: linear-gradient(90deg, transparent, var(--accent), transparent) no-repeat, var(--line); background-size: 40% 100%, 100% 100%; animation: travel 3.2s ease-in-out infinite; }
  @keyframes travel { from { background-position: -80% 0, 0 0; } to { background-position: 180% 0, 0 0; } }
  li:last-child::before { display: none; }
  @media (max-width: 819px) {
    li::before { display: none; }
    .process { gap: .8rem; }
    li { padding: 1rem 1rem 1rem 4rem; }
    .num { top: 1rem; left: 1rem; }
  }
  .num { position: absolute; top: 1.2rem; left: 1.2rem; display: grid; place-items: center; width: 36px; height: 36px; border-radius: 10px; font-family: var(--font-mono); font-size: .82rem; color: var(--accent); background: var(--accent-soft); box-shadow: inset 0 0 0 1px var(--accent-line); transition: background-color .4s, color .4s; }
  li:hover .num { background: var(--btn-bg); color: var(--btn-fg); }
  h3 { font-size: 1.05rem; }
  p { margin-top: .35rem; color: var(--ink-soft); font-size: .92rem; }
</style>
