---
// Form liên hệ gửi qua Web3Forms: tin nhắn được chuyển thẳng về email công ty.
// Cách bật: lấy access key tại https://web3forms.com rồi dán vào company.web3formsKey (src/data/site.ts)
import { getLang, localizePath } from '../i18n';
import { getData } from '../data';
const lang = getLang(Astro.url);
const { company, services } = getData(lang);
const t = {
  vi: {
    subject: `Yêu cầu tư vấn mới từ website ${company.name}`,
    name: 'Họ và tên', namePh: 'Nguyễn Văn An', phone: 'Số điện thoại', optional: '(không bắt buộc)', emailPh: 'ban@congty.vn',
    interest: 'Bạn quan tâm đến', message: 'Nội dung cần tư vấn',
    messagePh: 'Ví dụ: Homestay 12 phòng tại Đà Lạt, muốn làm tour 360° và website đặt phòng.',
    submit: 'Gửi yêu cầu tư vấn',
    invalid: 'Vui lòng điền đủ họ tên, số điện thoại và nội dung cần tư vấn.', sending: 'Đang gửi…',
    success: 'Đã gửi yêu cầu. Chúng tôi sẽ gọi lại cho bạn trong giờ làm việc.',
    error: 'Chưa gửi được yêu cầu. Bạn kiểm tra kết nối mạng hoặc gọi hotline để được hỗ trợ ngay.',
  },
  en: {
    subject: `New consultation request from the ${company.name} website (English)`,
    name: 'Full name', namePh: 'John Smith', phone: 'Phone number', optional: '(optional)', emailPh: 'you@company.com',
    interest: 'You are interested in', message: 'How can we help?',
    messagePh: 'E.g. a 12-room homestay in Da Lat looking for a 360° tour and a booking website.',
    submit: 'Send request',
    invalid: 'Please fill in your name, phone number and message.', sending: 'Sending…',
    success: 'Request sent. We will call you back during working hours.',
    error: 'Your request could not be sent. Please check your connection or call our hotline for immediate help.',
  },
}[lang];
import Icon from './Icon.astro';
---
<form class="form" data-contact novalidate data-msg-invalid={t.invalid} data-msg-sending={t.sending} data-msg-success={t.success} data-msg-error={t.error}>
  <input type="hidden" name="access_key" value={company.web3formsKey} />
  <input type="hidden" name="subject" value={t.subject} />
  <input type="checkbox" name="botcheck" class="sr-only" tabindex="-1" autocomplete="off" />

  <div class="row2">
    <label class="field">
      <span>{t.name}</span>
      <input name="name" type="text" required autocomplete="name" placeholder={t.namePh} />
    </label>
    <label class="field">
      <span>{t.phone}</span>
      <input name="phone" type="tel" required autocomplete="tel" pattern="[0-9 +().-]{9,}" placeholder="0901 234 567" />
    </label>
  </div>
  <label class="field">
    <span>Email <em>{t.optional}</em></span>
    <input name="email" type="email" autocomplete="email" placeholder={t.emailPh} />
  </label>

  <fieldset class="field">
    <legend>{t.interest}</legend>
    <div class="choices">
      {services.map((s, i) => (
        <label class={`choice tone-${s.tone}`}>
          <input type="checkbox" name="dich_vu" value={s.name} checked={i === 0} />
          <span><Icon name={s.icon} size={18} /> {s.name}</span>
        </label>
      ))}
    </div>
  </fieldset>

  <label class="field">
    <span>{t.message}</span>
    <textarea name="message" rows="5" required placeholder={t.messagePh}></textarea>
  </label>

  <div class="submit-row">
    <button class="btn btn--primary" type="submit"><Icon name="send" size={18} /> {t.submit}</button>
    <p class="status" data-status role="status" aria-live="polite"></p>
  </div>
</form>

<style>
  .form { display: grid; gap: 1.2rem; }
  .row2 { display: grid; gap: 1.2rem; }
  @media (min-width: 640px) { .row2 { grid-template-columns: 1fr 1fr; } }
  .field { display: grid; gap: .45rem; border: 0; padding: 0; margin: 0; min-width: 0; }
  .field > span, legend { font-weight: 600; font-size: .95rem; padding: 0; margin-bottom: .45rem; }
  .field em { font-weight: 400; color: var(--ink-soft); }
  input:not([type='checkbox']), textarea {
    width: 100%; padding: .9rem 1rem; border-radius: 14px; border: 0; background: var(--white);
    box-shadow: inset 0 0 0 1px var(--line); transition: box-shadow .25s; resize: vertical;
  }
  input:hover, textarea:hover { box-shadow: inset 0 0 0 1px var(--accent-line); }
  input:focus, textarea:focus { outline: none; box-shadow: inset 0 0 0 1.5px var(--accent), 0 0 0 4px var(--accent-soft); }
  .was-validated :invalid { box-shadow: inset 0 0 0 1.5px var(--danger); }
  ::placeholder { color: #a08e8f; }

  .choices { display: flex; flex-wrap: wrap; gap: .6rem; }
  .choice input { position: absolute; opacity: 0; pointer-events: none; }
  .choice span { display: inline-flex; align-items: center; gap: .45rem; padding: .6rem 1rem; border-radius: 999px; background: var(--white); box-shadow: inset 0 0 0 1px var(--line); cursor: pointer; font-weight: 600; font-size: .95rem; transition: background-color .25s, color .25s, box-shadow .25s; }
  .choice input:checked + span { background: var(--tone-soft); color: var(--tone); box-shadow: inset 0 0 0 1.5px var(--tone); }
  .choice input:focus-visible + span { outline: 2px solid var(--accent); outline-offset: 2px; }

  .submit-row { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.5rem; margin-top: .4rem; }
  button[data-loading] { opacity: .7; cursor: progress; }
  .status { font-size: .95rem; }
  .status[data-state='success'] { color: var(--success); font-weight: 600; }
  .status[data-state='error'] { color: var(--danger); font-weight: 600; }
</style>
