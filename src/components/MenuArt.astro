---
// Hình minh họa (tông đỏ đô thương hiệu) cho menu thả xuống (vẽ bằng SVG, nhẹ, không cần tải ảnh ngoài).
// Muốn thay bằng ảnh thật: truyền prop image="/images/menu/ten-anh.jpg"
interface Props { variant: 'core' | 'network' | 'signal'; image?: string; alt?: string }
const { variant, image, alt = '' } = Astro.props;
const id = `ma-${variant}`;

// Vệt sáng tỏa ra hai bên (hình "Giới thiệu")
const streaks = Array.from({ length: 14 }, (_, i) => {
  const a = (i - 6.5) * 0.085;
  return { a, len: 78 + ((i * 37) % 34), o: 0.5 + ((i * 53) % 50) / 100, d: (i % 5) * 0.4 };
});
// Lưới phối cảnh (hình "Dự án")
const vLines = Array.from({ length: 13 }, (_, i) => -120 + i * 40);
const hLines = [96, 104, 114, 127, 144];
const bits = ['0', '1', '1', '0', '1', '0', '0', '1'];
---
<div class:list={['art', `art--${variant}`]} aria-hidden={alt ? undefined : 'true'}>
  {image ? (
    <img src={image} alt={alt} loading="lazy" decoding="async" />
  ) : (
    <svg viewBox="0 0 240 150" preserveAspectRatio="xMidYMid slice">
      <defs>
        <radialGradient id={`${id}-bg`} cx="50%" cy="50%" r="70%">
          <stop offset="0%" stop-color="#9a2330" />
          <stop offset="55%" stop-color="#5a0910" />
          <stop offset="100%" stop-color="#2c0509" />
        </radialGradient>
        <radialGradient id={`${id}-glow`} cx="50%" cy="50%" r="50%">
          <stop offset="0%" stop-color="#fff1ee" stop-opacity="1" />
          <stop offset="30%" stop-color="#f4c2bc" stop-opacity=".75" />
          <stop offset="100%" stop-color="#b8434d" stop-opacity="0" />
        </radialGradient>
        <linearGradient id={`${id}-beam`} x1="0" y1="0" x2="1" y2="0">
          <stop offset="0%" stop-color="#f4c2bc" stop-opacity="0" />
          <stop offset="100%" stop-color="#f8d6d1" stop-opacity="1" />
        </linearGradient>
        <linearGradient id={`${id}-bar`} x1="0" y1="1" x2="0" y2="0">
          <stop offset="0%" stop-color="#b8434d" stop-opacity=".15" />
          <stop offset="100%" stop-color="#f4c2bc" stop-opacity=".95" />
        </linearGradient>
      </defs>
      <rect width="240" height="150" fill={`url(#${id}-bg)`} />

      {variant === 'core' && (
        <g>
          {/* Vệt sáng tốc độ cao hai bên */}
          {streaks.map((s) => (
            <g transform={`translate(120 78) rotate(${(s.a * 180) / Math.PI})`}>
              <rect class="beam" x={-26 - s.len} y="-.8" width={s.len} height="1.6" rx=".8" fill={`url(#${id}-beam)`} opacity={s.o} transform="scale(-1 1)" style={`animation-delay:${s.d}s`} />
              <rect class="beam" x={-26 - s.len} y="-.8" width={s.len} height="1.6" rx=".8" fill={`url(#${id}-beam)`} opacity={s.o} style={`animation-delay:${s.d + 0.2}s`} />
            </g>
          ))}
          {/* Mặt phẳng phản chiếu */}
          <ellipse cx="120" cy="112" rx="70" ry="9" fill="#f4c2bc" opacity=".14" />
          <ellipse cx="120" cy="112" rx="38" ry="4" fill="#f8d6d1" opacity=".35" />
          <circle cx="120" cy="78" r="58" fill={`url(#${id}-glow)`} opacity=".55" />
          <circle class="spin" cx="120" cy="78" r="36" fill="none" stroke="#f4c2bc" stroke-opacity=".55" stroke-dasharray="3 5" />
          <circle class="spin-rev" cx="120" cy="78" r="29" fill="none" stroke="#f8d6d1" stroke-opacity=".8" stroke-width="1.4" stroke-dasharray="26 8" />
          <circle cx="120" cy="78" r="22" fill="#3a060b" stroke="#f8d6d1" stroke-width="1.6" />
          <path d="M110 86 L116 75 L120 81 L130 69" fill="none" stroke="#fff1ee" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
          <circle class="blink" cx="130" cy="69" r="3" fill="#ffffff" />
          {bits.map((b, i) => (
            <text x={74 + i * 13} y={i % 2 ? 26 : 34} font-family="ui-monospace, monospace" font-size="8" fill="#f8d6d1" opacity={0.25 + (i % 3) * 0.2}>{b}</text>
          ))}
        </g>
      )}

      {variant === 'network' && (
        <g>
          {/* Lưới phối cảnh như bản đồ số */}
          <g stroke="#f4c2bc" stroke-opacity=".28" stroke-width=".8">
            {vLines.map((x) => <line x1={120 + x * 0.28} y1="92" x2={120 + x * 1.6} y2="150" />)}
            {hLines.map((y) => <line x1="0" y1={y} x2="240" y2={y} />)}
          </g>
          <rect y="70" width="240" height="26" fill="url(#ma-network-fade)" />
          <linearGradient id="ma-network-fade" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#5a0910" stop-opacity="0" />
            <stop offset="100%" stop-color="#5a0910" stop-opacity=".9" />
          </linearGradient>
          {/* Mạng kết nối */}
          <g stroke="#f8d6d1" stroke-width="1" stroke-opacity=".7" fill="none">
            <path class="dash" d="M52 64 L98 40 L150 56 L196 34" />
            <path class="dash" d="M98 40 L120 92 L150 56" />
            <path class="dash" d="M52 64 L120 92 L188 98" />
            <path class="dash" d="M196 34 L188 98" />
          </g>
          {[[52, 64], [98, 40], [150, 56], [196, 34], [188, 98]].map(([x, y], i) => (
            <g>
              <circle class="ping" cx={x} cy={y} r="7" fill="none" stroke="#f4c2bc" style={`animation-delay:${i * 0.5}s`} />
              <circle cx={x} cy={y} r="3.2" fill="#fff1ee" />
            </g>
          ))}
          {/* Ghim vị trí trung tâm */}
          <circle cx="120" cy="92" r="26" fill={`url(#${id}-glow)`} opacity=".5" />
          <g transform="translate(120 92)">
            <ellipse cx="0" cy="0" rx="12" ry="3.5" fill="none" stroke="#f4c2bc" stroke-opacity=".8" />
            <path class="float" d="M0 -6 C -9 -16 -9 -30 0 -32 C 9 -30 9 -16 0 -6 Z" fill="#b8434d" stroke="#fff1ee" stroke-width="1.4" />
            <circle class="float" cx="0" cy="-23" r="3.6" fill="#ffffff" />
          </g>
        </g>
      )}

      {variant === 'signal' && (
        <g>
          {/* Sóng phát tín hiệu */}
          <g fill="none" stroke="#f4c2bc" stroke-linecap="round">
            {[12, 22, 32, 42].map((r, i) => (
              <path class="wave" d={`M${168 - r * 0.8} ${58 - r * 0.6} A ${r} ${r} 0 0 1 ${168 + r * 0.8} ${58 - r * 0.6}`} stroke-opacity={0.8 - i * 0.16} style={`animation-delay:${i * 0.3}s`} />
            ))}
          </g>
          <circle cx="168" cy="60" r="4" fill="#ffffff" />
          <circle cx="168" cy="60" r="16" fill={`url(#${id}-glow)`} opacity=".7" />
          {/* Thẻ bài viết dạng kính */}
          <g transform="translate(26 40)">
            <rect x="10" y="-8" width="96" height="74" rx="9" fill="#4a070d" fill-opacity=".5" stroke="#f4c2bc" stroke-opacity=".25" />
            <rect x="0" y="0" width="100" height="78" rx="9" fill="#5a0910" fill-opacity=".85" stroke="#f8d6d1" stroke-opacity=".6" />
            <rect x="10" y="10" width="34" height="24" rx="5" fill="#b8434d" fill-opacity=".55" />
            <path d="M14 30 L22 21 L28 27 L34 20 L40 30" fill="none" stroke="#fff1ee" stroke-width="1.4" stroke-linejoin="round" />
            <rect x="50" y="12" width="40" height="4" rx="2" fill="#f8d6d1" fill-opacity=".85" />
            <rect x="50" y="21" width="30" height="3" rx="1.5" fill="#f8d6d1" fill-opacity=".4" />
            <rect x="50" y="29" width="34" height="3" rx="1.5" fill="#f8d6d1" fill-opacity=".4" />
            <rect x="10" y="44" width="80" height="3" rx="1.5" fill="#f8d6d1" fill-opacity=".35" />
            <rect x="10" y="52" width="70" height="3" rx="1.5" fill="#f8d6d1" fill-opacity=".35" />
            <rect x="10" y="60" width="56" height="3" rx="1.5" fill="#f8d6d1" fill-opacity=".35" />
          </g>
          {/* Biểu đồ tăng trưởng */}
          <g transform="translate(140 132)">
            {[18, 30, 24, 42, 56].map((h, i) => <rect class="bar" x={i * 15} y={-h} width="9" height={h} rx="2" fill={`url(#${id}-bar)`} style={`animation-delay:${i * 0.12}s`} />)}
          </g>
        </g>
      )}
    </svg>
  )}
</div>

<style>
  .art { position: relative; overflow: hidden; border-radius: 14px; background: #2c0509; box-shadow: inset 0 0 0 1px rgba(104, 10, 18, .25), 0 12px 30px -14px rgba(74, 7, 13, .7); }
  .art::after { content: ''; position: absolute; inset: 0; border-radius: inherit; pointer-events: none; background: linear-gradient(160deg, rgba(255, 255, 255, .12), transparent 35%); }
  .art svg, .art img { display: block; width: 100%; height: 100%; object-fit: cover; }

  .spin, .spin-rev { transform-box: view-box; transform-origin: 120px 78px; animation: ma-spin 14s linear infinite; }
  .spin-rev { animation-duration: 9s; animation-direction: reverse; }
  .beam { animation: ma-beam 2.4s ease-in-out infinite; }
  .blink { animation: ma-blink 1.8s ease-in-out infinite; }
  .dash { stroke-dasharray: 4 5; animation: ma-dash 1.6s linear infinite; }
  .ping { transform-box: fill-box; transform-origin: center; animation: ma-ping 2.4s ease-out infinite; }
  .float { animation: ma-float 3s ease-in-out infinite; }
  .wave { animation: ma-blink 2s ease-in-out infinite; }
  .bar { transform-box: fill-box; transform-origin: bottom; animation: ma-grow 2.8s var(--ease-out) infinite alternate; }

  @keyframes ma-spin { to { transform: rotate(360deg); } }
  @keyframes ma-beam { 50% { opacity: .15; } }
  @keyframes ma-blink { 50% { opacity: .35; } }
  @keyframes ma-dash { to { stroke-dashoffset: -18; } }
  @keyframes ma-ping { from { transform: scale(.6); opacity: .9; } to { transform: scale(2); opacity: 0; } }
  @keyframes ma-float { 50% { transform: translateY(-3px); } }
  @keyframes ma-grow { from { transform: scaleY(.55); } }
</style>
