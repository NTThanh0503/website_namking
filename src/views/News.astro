---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import NewsCard from '../components/NewsCard.astro';
import { getLang } from '../i18n';
import { getPosts } from '../i18n/posts';
const lang = getLang(Astro.url);
const posts = await getPosts(lang);
const t = {
  vi: {
    title: 'Tin tức',
    desc: 'Góc nhìn về số hóa điểm đến, kinh doanh du lịch trực tuyến và cộng đồng Kể Miền Di Sản.',
    hero: 'Tin tức và góc nhìn',
    lead: 'Chia sẻ từ đội ngũ Nam Kinh Digital về số hóa điểm đến, kinh doanh du lịch trực tuyến và cộng đồng Kể Miền Di Sản.',
  },
  en: {
    title: 'News',
    desc: 'Perspectives on destination digitization, selling travel online and the Ke Mien Di San community.',
    hero: 'News and perspectives',
    lead: 'From the Nam Kinh Digital team: destination digitization, selling travel online and the Ke Mien Di San community.',
  },
}[lang];
---
<BaseLayout title={t.title} description={t.desc}>
  <PageHero
    title={t.hero}
    lead={t.lead}
    crumbs={[{ label: t.title }]}
    seed={53}
  />
  <section class="section">
    <div class="container grid">
      {posts.map((p, i) => <div data-reveal style={`--d:${(i % 3) * 90}ms`}><NewsCard post={p} index={i} /></div>)}
    </div>
  </section>
</BaseLayout>
<style>
  .grid { display: grid; gap: 3rem 2rem; }
  @media (min-width: 700px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1040px) { .grid { grid-template-columns: repeat(3, 1fr); } }
</style>
