---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import Testimonials from '../components/Testimonials.astro';
import CtaBand from '../components/CtaBand.astro';
import { getLang } from '../i18n';
const lang = getLang(Astro.url);
const t = {
  vi: {
    title: 'Dự án',
    desc: 'Mô hình triển khai mẫu của Nam Kinh Digital cho di tích, bảo tàng, làng nghề, khu du lịch và cơ sở lưu trú.',
    hero: 'Mô hình triển khai mẫu',
    lead: 'Các mô hình minh họa cách giải pháp được áp dụng cho từng loại điểm đến trong giai đoạn triển khai điểm mẫu. Dự án thực tế sẽ được cập nhật ngay khi bàn giao. Chọn giải pháp để xem mô hình phù hợp.',
    quotes: 'Thông điệp của chúng tôi',
    cta: 'Điểm đến của bạn có thể là điểm mẫu tiếp theo',
  },
  en: {
    title: 'Projects',
    desc: 'Nam Kinh Digital pilot deployment models for heritage sites, museums, craft villages, tourist areas and accommodation.',
    hero: 'Pilot deployment models',
    lead: 'Illustrative models of how our solutions apply to each kind of destination during the pilot phase. Real projects will be added as they are delivered. Pick a solution to see the relevant models.',
    quotes: 'Our message',
    cta: 'Your destination could be our next pilot',
  },
}[lang];
---
<BaseLayout title={t.title} description={t.desc}>
  <PageHero
    title={t.hero}
    lead={t.lead}
    crumbs={[{ label: t.title }]}
    seed={47}
  />
  <section class="section">
    <div class="container"><ProjectGrid /></div>
  </section>
  <section class="section quotes">
    <div class="container" data-reveal>
      <h2 class="sr-only">{t.quotes}</h2>
      <Testimonials />
    </div>
  </section>
  <CtaBand title={t.cta} />
</BaseLayout>
<style>
  .quotes { border-block: 1px solid var(--line); background: radial-gradient(40rem 24rem at 50% 0%, rgba(184, 67, 77, .1), transparent 70%), var(--surface); }
</style>
