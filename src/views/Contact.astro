---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ContactForm from '../components/ContactForm.astro';
import Faq from '../components/Faq.astro';
import Icon from '../components/Icon.astro';
import { getLang } from '../i18n';
import { getData } from '../data';
const lang = getLang(Astro.url);
const { company } = getData(lang);
const t = {
  vi: {
    title: 'Liên hệ',
    desc: `Liên hệ ${company.name} để được tư vấn miễn phí về số hóa, lưu trú và du lịch.`,
    hero: 'Kể cho chúng tôi về dự án của bạn',
    lead: 'Điền form bên dưới hoặc gọi trực tiếp. Chuyên viên sẽ liên hệ lại trong 24 giờ làm việc.',
    form: 'Gửi yêu cầu tư vấn',
    phone: 'Điện thoại', office: 'Văn phòng', hours: 'Giờ làm việc',
    map: `Bản đồ đường đến văn phòng ${company.name}`,
    faq: 'Câu hỏi thường gặp',
    directions: 'Chỉ đường', openMaps: 'Mở Google Maps để chỉ đường đến văn phòng',
  },
  en: {
    title: 'Contact',
    desc: `Contact ${company.name} for a free consultation on digital transformation, hospitality and travel.`,
    hero: 'Tell us about your project',
    lead: 'Fill in the form below or call us directly. A consultant will get back to you within 24 working hours.',
    form: 'Request a consultation',
    phone: 'Phone', office: 'Office', hours: 'Working hours',
    map: `Map to the ${company.name} office`,
    faq: 'Frequently asked questions',
    directions: 'Get directions', openMaps: 'Open Google Maps for directions to our office',
  },
}[lang];
const info = [
  { icon: 'phone', label: t.phone, value: company.phone, href: company.phoneHref },
  { icon: 'mail', label: 'Email', value: company.email, href: `mailto:${company.email}` },
  { icon: 'pin', label: t.office, value: company.address, href: company.mapDirections, external: true, iconLabel: t.openMaps },
  { icon: 'clock', label: t.hours, value: company.hours },
];
---
<BaseLayout title={t.title} description={t.desc}>
  <PageHero
    title={t.hero}
    lead={t.lead}
    crumbs={[{ label: t.title }]}
    seed={59}
  />

  <section class="section">
    <div class="container contact">
      <div class="form-card" data-reveal>
        <h2>{t.form}</h2>
        <ContactForm />
      </div>
      <aside class="info" data-reveal style="--d:120ms">
        <ul>
          {info.map((i) => (
            <li>
              {i.href ? (
                <a class="i-icon" href={i.href} target={i.external ? '_blank' : undefined} rel={i.external ? 'noopener' : undefined} aria-label={i.iconLabel ?? `${i.label}: ${i.value}`}><Icon name={i.icon} size={22} /></a>
              ) : (
                <span class="i-icon"><Icon name={i.icon} size={22} /></span>
              )}
              <span><small>{i.label}</small>{i.href ? <a href={i.href} target={i.external ? '_blank' : undefined} rel={i.external ? 'noopener' : undefined}>{i.value}</a> : <strong>{i.value}</strong>}</span>
            </li>
          ))}
        </ul>
        <div class="socials">
          {company.socials.map((s) => <a href={s.href} target="_blank" rel="noopener"><Icon name={s.icon} size={18} /> {s.name}</a>)}
        </div>
      </aside>
    </div>
  </section>

  <section class="map-section">
    <div class="container">
      <div class="map-frame">
        <iframe src={company.mapEmbed} title={t.map} loading="lazy" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
        <a class="btn btn--primary map-btn" href={company.mapDirections} target="_blank" rel="noopener" aria-label={t.openMaps}>
          <Icon name="pin" size={18} /> {t.directions}
        </a>
      </div>
    </div>
  </section>

  <section class="section" id="hoi-dap">
    <div class="container faq-wrap">
      <h2 data-reveal>{t.faq}</h2>
      <div data-reveal><Faq /></div>
    </div>
  </section>
</BaseLayout>
<style>
  .contact { display: grid; gap: 3rem; align-items: start; }
  @media (min-width: 980px) { .contact { grid-template-columns: 1.35fr .65fr; gap: 4rem; } }
  .form-card { padding: clamp(1.5rem, 4vw, 3rem); border-radius: var(--radius-l); background: var(--surface); box-shadow: inset 0 0 0 1px var(--line), 0 40px 100px -50px rgba(74, 7, 13, .5); }
  .form-card h2 { font-size: var(--fs-xl); margin-bottom: 1.8rem; }
  .info ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 1.8rem; }
  .info li { display: flex; gap: 1rem; }
  .i-icon { flex: none; display: grid; place-items: center; width: 50px; height: 50px; border-radius: 15px; background: var(--accent-soft); color: var(--accent); box-shadow: inset 0 0 0 1px var(--accent-line); }
  .info small { display: block; color: var(--ink-soft); font-size: .88rem; }
  .info a, .info strong { font-weight: 600; text-decoration: none; font-size: 1.05rem; line-height: 1.45; }
  .info a:hover { color: var(--accent); }
  .socials { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: 2.2rem; }
  .socials a { display: inline-flex; align-items: center; gap: .4rem; padding: .5rem .9rem; border-radius: 999px; text-decoration: none; font-weight: 600; font-size: .9rem; min-height: 44px; box-shadow: inset 0 0 0 1px var(--line); transition: background-color .25s, box-shadow .25s; }
  .socials a:hover { background: var(--accent-soft); color: var(--accent); box-shadow: inset 0 0 0 1px var(--accent-line); }
  a.i-icon { transition: background-color .25s, box-shadow .25s, transform .25s; }
  a.i-icon:hover, a.i-icon:active { background: var(--maroon); color: var(--ivory); box-shadow: 0 10px 22px -12px rgba(74, 7, 13, .8); transform: translateY(-1px); }
  .map-frame { position: relative; overflow: hidden; border-radius: var(--radius-l); background: var(--surface); box-shadow: inset 0 0 0 1px var(--line); }
  iframe { display: block; width: 100%; height: 420px; border: 0; }
  /* Bản đồ hơi ngả ấm cho hợp tông ngà (chỉ trên máy tính: điện thoại hay vẽ lỗi khi lọc màu khung nhúng) */
  @media (hover: hover) and (pointer: fine) { iframe { filter: sepia(.18) saturate(.85); } }
  .map-btn { position: absolute; right: 1rem; bottom: 1.6rem; }
  @media (max-width: 640px) {
    iframe { height: 320px; }
    .map-btn { position: static; display: flex; width: 100%; border-radius: 0; min-height: 54px; }
  }
  .faq-wrap { max-width: 52rem; }
  .faq-wrap h2 { margin-bottom: 2rem; }
</style>
