---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Partners from '../components/Partners.astro';
import ServiceTabs from '../components/ServiceTabs.astro';
import Stats from '../components/Stats.astro';
import Process from '../components/Process.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import Testimonials from '../components/Testimonials.astro';
import NewsCard from '../components/NewsCard.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { getLang, localizePath } from '../i18n';
import { getPosts } from '../i18n/posts';

const lang = getLang(Astro.url);
const L = (href: string) => localizePath(href, lang);
const posts = (await getPosts(lang)).slice(0, 3);
const t = {
  vi: {
    partners: 'Kết nối sẵn với các kênh bán phòng, thanh toán và bản đồ phổ biến',
    svcTitle: 'Ba mảng dịch vụ, một hành trình liền mạch',
    svcLead: 'Khách tìm thấy bạn nhờ số hóa, ở lại nhờ dịch vụ lưu trú chu đáo, và quay lại nhờ những hành trình đáng nhớ. Chúng tôi làm được cả ba, hoặc từng phần bạn cần.',
    statsTitle: 'Tám năm đồng hành cùng ngành du lịch Việt',
    statsLead: 'Từ một nhóm nhỏ chụp ảnh 360° cho khách sạn, chúng tôi đã cùng hàng trăm đối tác đưa điểm đến của họ đến gần hơn với du khách.',
    process: 'Cách chúng tôi làm việc',
    projTitle: 'Dự án tiêu biểu',
    projLead: 'Một vài dự án gần đây trong cả ba lĩnh vực. Mỗi dự án đều bắt đầu từ một mục tiêu cụ thể của khách hàng.',
    projAll: 'Xem tất cả dự án',
    quotes: 'Khách hàng nói về chúng tôi',
    newsTitle: 'Tin tức và kinh nghiệm',
    newsLead: 'Chia sẻ thực tế về số hóa, vận hành lưu trú và những hành trình đáng đi.',
    newsAll: 'Đọc tất cả bài viết',
    faqTitle: 'Câu hỏi thường gặp',
    faqLead: 'Chưa thấy câu trả lời bạn cần? Gọi hotline hoặc để lại lời nhắn, chúng tôi phản hồi trong ngày.',
    faqAsk: 'Đặt câu hỏi khác',
  },
  en: {
    partners: 'Ready-made connections to popular booking channels, payment gateways and maps',
    svcTitle: 'Three services, one seamless journey',
    svcLead: 'Guests find you thanks to digital, stay thanks to thoughtful hospitality, and come back thanks to memorable journeys. We can do all three, or just the part you need.',
    statsTitle: 'Eight years alongside Vietnam’s travel industry',
    statsLead: 'From a small team shooting 360° photos for hotels, we have helped hundreds of partners bring their destinations closer to travellers.',
    process: 'How we work',
    projTitle: 'Featured projects',
    projLead: 'A few recent projects across all three areas. Every project starts from a specific client goal.',
    projAll: 'See all projects',
    quotes: 'What our clients say',
    newsTitle: 'News and insights',
    newsLead: 'Practical insights on digital transformation, hospitality operations and journeys worth taking.',
    newsAll: 'Read all articles',
    faqTitle: 'Frequently asked questions',
    faqLead: 'Can’t find the answer you need? Call our hotline or leave a message and we will reply the same day.',
    faqAsk: 'Ask another question',
  },
}[lang];
---

<BaseLayout>
  <Hero />

  <section class="partners">
    <div class="container">
      <p class="partners-label">{t.partners}</p>
    </div>
    <Partners />
  </section>

  <section class="section section--tint" id="dich-vu">
    <div class="container">
      <div class="section-head section-head--split" data-reveal>
        <h2>{t.svcTitle}</h2>
        <p class="lead">{t.svcLead}</p>
      </div>
      <div data-reveal><ServiceTabs /></div>
    </div>
  </section>

  <section class="section section--dark">
    <div class="container">
      <div class="section-head" data-reveal>
        <h2>{t.statsTitle}</h2>
        <p class="lead">{t.statsLead}</p>
      </div>
      <Stats />
      <div class="process-wrap">
        <h3 class="process-title" data-reveal>{t.process}</h3>
        <Process />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head section-head--split" data-reveal>
        <h2>{t.projTitle}</h2>
        <div class="head-side">
          <p class="lead">{t.projLead}</p>
          <a class="link" href={L('/du-an')}>{t.projAll} <Icon name="arrow" size={18} /></a>
        </div>
      </div>
      <ProjectGrid limit={3} filter={false} />
    </div>
  </section>

  <section class="section testimonials">
    <div class="container" data-reveal>
      <h2 class="sr-only">{t.quotes}</h2>
      <Testimonials />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head section-head--split" data-reveal>
        <h2>{t.newsTitle}</h2>
        <div class="head-side">
          <p class="lead">{t.newsLead}</p>
          <a class="link" href={L('/tin-tuc')}>{t.newsAll} <Icon name="arrow" size={18} /></a>
        </div>
      </div>
      <div class="news-grid">
        {posts.map((p, i) => <div data-reveal style={`--d:${i * 90}ms`}><NewsCard post={p} index={i} /></div>)}
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container faq-grid">
      <div data-reveal>
        <h2>{t.faqTitle}</h2>
        <p class="lead faq-lead">{t.faqLead}</p>
        <a class="btn" href={L('/lien-he')}>{t.faqAsk}</a>
      </div>
      <div data-reveal style="--d:120ms"><Faq /></div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .partners { padding-block: 0 clamp(3rem, 6vw, 5rem); }
  .partners-label { font-size: var(--fs-sm); color: var(--ink-soft); margin-bottom: 1.4rem; }
  .process-wrap { margin-top: clamp(4rem, 8vw, 6rem); padding-top: clamp(3rem, 6vw, 4rem); border-top: 1px solid var(--line); }
  .process-title { margin-bottom: 2.5rem; font-size: var(--fs-xl); }
  .head-side { display: grid; gap: 1rem; justify-items: start; }
  .testimonials { overflow: hidden; border-block: 1px solid var(--line); background: radial-gradient(40rem 24rem at 50% 0%, rgba(184, 67, 77, .1), transparent 70%), var(--surface); }
  .news-grid { display: grid; gap: 2.5rem 2rem; }
  @media (min-width: 760px) { .news-grid { grid-template-columns: repeat(3, 1fr); } }
  .faq-grid { display: grid; gap: 2.5rem; }
  @media (min-width: 960px) { .faq-grid { grid-template-columns: .8fr 1.2fr; gap: 5rem; } }
  .faq-lead { margin: 1.2rem 0 2rem; }
</style>
