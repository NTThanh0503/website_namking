---
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import NewsCard from '../components/NewsCard.astro';
import CtaBand from '../components/CtaBand.astro';
import { getLang, localizePath, locales } from '../i18n';
import { getPosts, type Post } from '../i18n/posts';
import { getData } from '../data';

interface Props { post: Post }
const { post } = Astro.props;
const lang = getLang(Astro.url);
const { services } = getData(lang);
const { Content } = await render(post);
const svc = services.find((s) => s.slug === post.data.category)!;
const date = post.data.date.toLocaleDateString(locales[lang], { day: '2-digit', month: 'long', year: 'numeric' });
const more = (await getPosts(lang)).filter((p) => p.id !== post.id).slice(0, 2);
const t = { vi: { news: 'Tin tức', more: 'Bài viết khác' }, en: { news: 'News', more: 'More articles' } }[lang];
---
<BaseLayout title={post.data.title} description={post.data.description}>
  <PageHero title={post.data.title} crumbs={[{ label: t.news, href: localizePath('/tin-tuc', lang) }, { label: svc.name }]} seed={29}>
    <p class="byline">{post.data.author}, {date}</p>
  </PageHero>
  <section class="section">
    <article class="container article">
      <p class="intro">{post.data.description}</p>
      <Content />
    </article>
  </section>
  {more.length > 0 && (
    <section class="section section--tint">
      <div class="container">
        <h2 class="more-title">{t.more}</h2>
        <div class="grid">{more.map((p, i) => <NewsCard post={p} index={i + 1} />)}</div>
      </div>
    </section>
  )}
  <CtaBand />
</BaseLayout>
<style>
  .byline { margin-top: 1.2rem; color: var(--ink-soft); }
  .article { max-width: 46rem; font-size: 1.1rem; line-height: 1.75; }
  .intro { font-size: 1.3rem; line-height: 1.6; color: var(--ink); margin-bottom: 2rem; }
  .article :global(h2) { font-size: 1.6rem; margin: 2.6rem 0 .8rem; }
  .article :global(p) { margin-bottom: 1.1rem; color: var(--ink-soft); }
  .article :global(a) { color: var(--jade); font-weight: 600; }
  .more-title { font-size: var(--fs-xl); margin-bottom: 2rem; }
  .grid { display: grid; gap: 2.5rem 2rem; }
  @media (min-width: 760px) { .grid { grid-template-columns: 1fr 1fr; } }
</style>
