---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import ArtTile from '../components/ArtTile.astro';
import { getLang } from '../i18n';
import { getData } from '../data';
const lang = getLang(Astro.url);
const { company, values, milestones, team } = getData(lang);
const valueIcons = ['eye', 'heart', 'chart'];
const initials = (n: string) => n.split(' ').slice(-2).map((w) => w[0]).join('');
const t = {
  vi: {
    title: 'Giới thiệu',
    desc: `${company.brand} – thương hiệu công nghệ du lịch của ${company.name}: ${company.positioning}.`,
    hero: 'Đưa du lịch Việt từ đời thực lên môi trường số',
    lead: `${company.brand} là thương hiệu công nghệ du lịch của ${company.name}, định vị là ${company.positioning.toLowerCase()}.`,
    story: 'Chúng tôi là ai',
    storyP: [
      `${company.brand} cung cấp giải pháp đưa các điểm đến, sản phẩm và dịch vụ du lịch từ môi trường thực tế lên môi trường số.`,
      'Về dài hạn, chúng tôi xây dựng mạng lưới điểm đến số và hệ thống dữ liệu du lịch phục vụ phát triển sản phẩm, dịch vụ và hoạt động thương mại.',
    ],
    helpTitle: 'Chúng tôi giúp đơn vị kinh doanh du lịch',
    help: [
      'Xây dựng hình ảnh và hiện diện trực tuyến chuyên nghiệp',
      'Số hóa không gian, thông tin, câu chuyện và trải nghiệm',
      'Giới thiệu, quảng bá sản phẩm đến khách du lịch',
      'Tiếp nhận đặt dịch vụ, kết nối giao dịch',
      'Quản trị hoạt động kinh doanh trên một nền tảng',
      'Thu thập, phân tích dữ liệu phục vụ vận hành trong phạm vi được phép',
    ],
    vm: 'Tầm nhìn và sứ mệnh',
    vision: 'Tầm nhìn',
    visionP: 'Trở thành một nền tảng công nghệ du lịch tại Việt Nam, kết nối các điểm đến, doanh nghiệp cung cấp dịch vụ và du khách trên cùng hệ sinh thái số.',
    mission: 'Sứ mệnh',
    missionP: 'Biến những tài nguyên, trải nghiệm và dịch vụ du lịch đang tồn tại ngoài đời thực thành những sản phẩm có thể khám phá, tiếp cận, đặt mua và quản lý trên môi trường số.',
    brands: 'Hai thương hiệu, hai vai trò',
    brandsLead: `${company.community} được phát triển và vận hành bởi ${company.brand}. Hai thương hiệu có website và Facebook riêng, dùng chung công nghệ lõi, với quyền truy cập và dữ liệu được phân tách rõ ràng.`,
    brandList: [
      { name: company.brand, slogan: company.positioning, for: 'Doanh nghiệp, cơ quan quản lý, đối tác', role: 'Cung cấp công nghệ và các giải pháp thương mại', topics: ['Công nghệ du lịch', 'Số hóa điểm đến', 'Giải pháp kinh doanh', 'Quản trị và dữ liệu', 'Kết quả dự án', 'Hợp tác công nghệ'] },
      { name: company.community, slogan: 'Đánh thức di sản bằng công nghệ', for: 'Người dân, du khách, cộng đồng yêu văn hóa', role: 'Nội dung, cộng đồng, khám phá điểm đến, thu hút người dùng', topics: ['Di tích', 'Di sản', 'Làng nghề', 'Điểm đến văn hóa', 'Ảnh 360°', 'Câu chuyện địa phương'] },
    ],
    forLabel: 'Đối tượng', roleLabel: 'Vai trò',
    values: 'Giá trị cốt lõi',
    valuesLead: 'Ba điều chúng tôi giữ trong mọi dự án, dù là một xưởng gốm làng nghề hay một bảo tàng cấp tỉnh.',
    timeline: 'Lộ trình phát triển 2027–2029',
    timelineLead: 'Tăng dần tỷ trọng doanh thu định kỳ từ phần mềm, mở rộng mạng lưới điểm đến và tài sản dữ liệu dài hạn.',
    phase: 'Giai đoạn',
    team: 'Đội ngũ',
    teamLead: 'Những người chịu trách nhiệm trực tiếp với từng mảng sản phẩm.',
    cta: 'Cùng đưa điểm đến của bạn lên bản đồ số',
  },
  en: {
    title: 'About us',
    desc: `${company.brand}, the travel technology brand of ${company.name}: ${company.positioning}.`,
    hero: 'Bringing Vietnamese travel from the real world into the digital one',
    lead: `${company.brand} is the travel technology brand of ${company.name}, positioned as ${company.positioning.toLowerCase()}.`,
    story: 'Who we are',
    storyP: [
      `${company.brand} provides solutions that take destinations, travel products and services from the physical world into the digital one.`,
      'In the long run we are building a network of digital destinations and a travel data system to support new products, services and commerce.',
    ],
    helpTitle: 'We help travel businesses',
    help: [
      'Build a professional image and online presence',
      'Digitize spaces, information, stories and experiences',
      'Present and promote their products to travellers',
      'Take bookings and connect transactions',
      'Run their business on one platform',
      'Collect and analyse data for operations, within permitted scope',
    ],
    vm: 'Vision and mission',
    vision: 'Vision',
    visionP: 'To become a travel technology platform in Vietnam that connects destinations, service providers and travellers in one digital ecosystem.',
    mission: 'Mission',
    missionP: 'To turn the travel resources, experiences and services that exist in the real world into products people can discover, access, book and manage digitally.',
    brands: 'Two brands, two roles',
    brandsLead: `${company.community} is developed and run by ${company.brand}. Each brand has its own website and Facebook page and shares the same core technology, with access and data clearly separated.`,
    brandList: [
      { name: company.brand, slogan: company.positioning, for: 'Businesses, authorities, partners', role: 'Provides the technology and commercial solutions', topics: ['Travel technology', 'Destination digitization', 'Business solutions', 'Management and data', 'Project results', 'Technology partnerships'] },
      { name: company.community, slogan: 'Awakening heritage with technology', for: 'Local people, travellers, culture lovers', role: 'Content, community, destination discovery, audience growth', topics: ['Historic sites', 'Heritage', 'Craft villages', 'Cultural destinations', '360° imagery', 'Local stories'] },
    ],
    forLabel: 'Audience', roleLabel: 'Role',
    values: 'Core values',
    valuesLead: 'Three things we hold to in every project, whether it is a village pottery workshop or a provincial museum.',
    timeline: 'Roadmap 2027–2029',
    timelineLead: 'Steadily growing recurring software revenue, the destination network and long-term data assets.',
    phase: 'Phase',
    team: 'Our team',
    teamLead: 'The people directly responsible for each product line.',
    cta: 'Let’s put your destination on the digital map',
  },
}[lang];
---
<BaseLayout title={t.title} description={t.desc}>
  <PageHero
    title={t.hero}
    lead={t.lead}
    crumbs={[{ label: t.title }]}
    seed={23}
  />

  <section class="section" id="cau-chuyen">
    <div class="container story">
      <div data-reveal>
        <h2>{t.story}</h2>
        <div class="prose">
          {t.storyP.map((p) => <p>{p}</p>)}
        </div>
        <h3 class="help-title">{t.helpTitle}</h3>
        <ul class="help">
          {t.help.map((h) => <li><Icon name="check" size={18} /> {h}</li>)}
        </ul>
      </div>
      <div class="story-art" data-reveal style="--d:120ms">
        <ArtTile image="/images/gioi-thieu/cau-chuyen.jpg" tone="lagoon" seed={61} icon="temple" ratio="4 / 3" />
      </div>
    </div>
  </section>

  <section class="section section--dark" id="tam-nhin">
    <div class="container">
      <div class="section-head" data-reveal>
        <h2>{t.vm}</h2>
      </div>
      <div class="mission">
        <div data-reveal>
          <h3>{t.vision}</h3>
          <p>{t.visionP}</p>
        </div>
        <div data-reveal style="--d:120ms">
          <h3>{t.mission}</h3>
          <p>{t.missionP}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="hai-thuong-hieu">
    <div class="container">
      <div class="section-head" data-reveal>
        <h2>{t.brands}</h2>
        <p class="lead">{t.brandsLead}</p>
      </div>
      <div class="brands">
        {t.brandList.map((b, i) => (
          <article class:list={['brand', { 'brand--community': i === 1 }]} data-reveal style={`--d:${i * 120}ms`}>
            <span class="brand-mark"><Icon name={i === 0 ? 'cube' : 'temple'} size={28} /></span>
            <h3>{b.name}</h3>
            <p class="brand-slogan">{b.slogan}</p>
            <dl>
              <div><dt>{t.forLabel}</dt><dd>{b.for}</dd></div>
              <div><dt>{t.roleLabel}</dt><dd>{b.role}</dd></div>
            </dl>
            <ul class="topics">{b.topics.map((x) => <li>{x}</li>)}</ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--tint" id="gia-tri">
    <div class="container">
      <div class="section-head" data-reveal>
        <h2>{t.values}</h2>
        <p class="lead">{t.valuesLead}</p>
      </div>
      <div class="values">
        {values.map((v, i) => (
          <article data-reveal style={`--d:${i * 100}ms`}>
            <span class="v-icon"><Icon name={valueIcons[i]} size={26} /></span>
            <h3>{v.title}</h3>
            <p>{v.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="chang-duong">
    <div class="container">
      <div class="section-head" data-reveal><h2>{t.timeline}</h2><p class="lead">{t.timelineLead}</p></div>
      <ol class="timeline">
        {milestones.map((m, i) => (
          <li data-reveal style={`--d:${i * 80}ms`}>
            <span class="year">{m.year}</span>
            <p><strong>{t.phase} {i + 1}.</strong> {m.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section" id="doi-ngu">
    <div class="container">
      <div class="section-head" data-reveal>
        <h2>{t.team}</h2>
        <p class="lead">{t.teamLead}</p>
      </div>
      <div class="team">
        {team.map((m, i) => (
          <article data-reveal style={`--d:${i * 90}ms`}>
            {/* Thay khối chữ cái bằng ảnh thật: <img src="/images/team/ten.jpg" alt={m.name} /> */}
            <div class="avatar" aria-hidden="true">{initials(m.name)}</div>
            <h3>{m.name}</h3>
            <p class="role">{m.role}</p>
            <p>{m.bio}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CtaBand title={t.cta} />
</BaseLayout>

<style>
  .story { display: grid; gap: 2rem; align-items: center; }
  @media (min-width: 960px) { .story { grid-template-columns: 1.4fr .6fr; gap: 3rem; } }
  .prose { margin-top: 1.6rem; display: grid; gap: 1.1rem; color: var(--ink-soft); max-width: 40rem; font-size: 1.08rem; }
  .mission { display: grid; gap: 1.6rem; }
  @media (min-width: 820px) { .mission { grid-template-columns: 1fr 1fr; gap: 3rem; } }
  .help-title { margin-top: 2.2rem; font-size: 1.15rem; }
  .help { list-style: none; padding: 0; margin: 1rem 0 0; display: grid; gap: .7rem; }
  @media (min-width: 640px) { .help { grid-template-columns: 1fr 1fr; gap: .7rem 1.5rem; } }
  .help li { display: flex; gap: .55rem; align-items: flex-start; font-size: .98rem; }
  .help :global(svg) { flex: none; margin-top: .25rem; color: var(--accent); }
  .brands { display: grid; gap: 1.5rem; }
  @media (min-width: 860px) { .brands { grid-template-columns: 1fr 1fr; } }
  .brand { padding: clamp(1.25rem, 2.4vw, 1.8rem); border-radius: var(--radius-l); background: var(--white); box-shadow: inset 0 0 0 1px var(--line); }
  .brand--community { --ink: #f6f1ee; --ink-soft: rgba(240, 236, 233, .76); --accent: var(--blush); --accent-soft: rgba(244, 194, 188, .12); --accent-line: rgba(244, 194, 188, .38); --line: rgba(240, 236, 233, .16); color: var(--ink); background: radial-gradient(30rem 18rem at 90% 0%, rgba(184, 67, 77, .5), transparent 70%), linear-gradient(160deg, var(--maroon), var(--maroon-deep)); box-shadow: none; }
  .brand-mark { display: grid; place-items: center; width: 44px; height: 44px; margin-bottom: .9rem; border-radius: 13px; color: var(--accent); background: var(--accent-soft); box-shadow: inset 0 0 0 1px var(--accent-line); }
  .brand h3 { font-family: var(--font-brand); font-weight: 800; font-size: 1.25rem; letter-spacing: 0; }
  .brand-slogan { margin-top: .3rem; color: var(--accent); font-weight: 600; }
  .brand dl { display: grid; gap: .9rem; margin: 1.6rem 0; }
  .brand dt { font-family: var(--font-mono); font-size: .7rem; letter-spacing: .1em; text-transform: uppercase; color: var(--ink-soft); }
  .brand dd { margin: .15rem 0 0; }
  .topics { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: .45rem; }
  .topics li { padding: .3rem .75rem; border-radius: 999px; font-size: .85rem; box-shadow: inset 0 0 0 1px var(--accent-line); }
  .mission h3 { color: var(--accent); margin-bottom: .8rem; }
  .mission p { font-size: 1.15rem; opacity: .9; max-width: 34rem; }
  .values { display: grid; gap: 1.6rem; }
  @media (min-width: 820px) { .values { grid-template-columns: repeat(3, 1fr); } }
  .v-icon { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 13px; background: var(--accent-soft); color: var(--accent); box-shadow: inset 0 0 0 1px var(--accent-line); margin-bottom: .9rem; }
  .values p { margin-top: .6rem; color: var(--ink-soft); }
  .timeline { list-style: none; padding: 0; margin: 0; position: relative; display: grid; gap: 0; }
  .timeline::before { content: ''; position: absolute; left: 5.2rem; top: .6rem; bottom: .6rem; width: 2px; background: color-mix(in srgb, var(--maroon) 22%, transparent); }
  .timeline li { position: relative; display: grid; grid-template-columns: 4.2rem 1fr; gap: 2.2rem; padding-block: .75rem; }
  .timeline li::after { content: ''; position: absolute; left: calc(5.2rem - 6px); top: 1.55rem; width: 14px; height: 14px; border-radius: 50%; background: var(--maroon); box-shadow: 0 0 0 5px var(--paper), 0 0 0 6px var(--accent-line); }
  .year { font-family: var(--font-display); font-weight: 600; font-size: 1.3rem; letter-spacing: -0.02em; color: var(--accent); }
  .timeline p { max-width: 40rem; padding-top: .15rem; }
  .team { display: grid; gap: 1.6rem 1.4rem; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); }
  .avatar { aspect-ratio: 1; border-radius: var(--radius-m); background: radial-gradient(circle at 70% 25%, rgba(184, 67, 77, .7), transparent 60%), var(--maroon); box-shadow: inset 0 0 0 1px var(--line); color: var(--ivory); font-family: var(--font-display); display: grid; place-items: center; font-size: 2.8rem; font-weight: 700; letter-spacing: -0.04em; margin-bottom: 1.2rem; }
  .team article:nth-child(2) .avatar { background: radial-gradient(circle at 30% 70%, rgba(244, 194, 188, .35), transparent 60%), var(--maroon-deep); }
  .team article:nth-child(3) .avatar { background: radial-gradient(circle at 60% 60%, rgba(201, 162, 126, .45), transparent 60%), var(--maroon); }
  .team article:nth-child(4) .avatar { background: radial-gradient(circle at 30% 30%, rgba(184, 67, 77, .6), transparent 60%), var(--maroon-ink); }
  .team h3 { font-size: 1.05rem; }
  .role { color: var(--accent); font-weight: 600; font-size: .95rem; margin: .2rem 0 .5rem; }
  .team p:last-child { color: var(--ink-soft); font-size: .95rem; }
</style>
